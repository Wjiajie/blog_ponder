---
interface Props {
  variant?: 'default' | 'minimal';
}

const { variant: _variant = 'default' } = Astro.props;
---

<aside class="col-right">
  <div class="aside-inner">
    <slot />
  </div>
</aside>

<style>
  .aside-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
</style>
