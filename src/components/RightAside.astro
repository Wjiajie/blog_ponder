---
// RightAside is a pure slot container — variant is intentionally not
// exposed: every page renders the same chrome and any visual differences
// belong in the caller's <Fragment slot="aside"> content, not in this shell.
---

<aside class="col-right">
  <div class="aside-inner">
    <slot />
  </div>
</aside>

<style>
  .aside-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
</style>
