---
import { ROUTES } from '../consts';
import { getPublishedPosts } from '../lib/blog';
import { truncate } from '../lib/text';

interface Props {
  maxItems?: number;
  emptyText?: string;
  viewAllText?: string;
}

const {
  maxItems = 4,
  emptyText = '暂无随想。',
  viewAllText = '查看全部随想 →',
} = Astro.props;

const posts = (await getPublishedPosts()).slice(0, maxItems);
---

{posts.length === 0 ? (
  <p class="empty-state">{emptyText}<a href={ROUTES.blog}>{viewAllText}</a></p>
) : (
  <>
    <ul class="bullet-list">
      {posts.map((post) => (
        <li>
          <strong>
            <a href={ROUTES.blogPost(post.slug)}>{post.data.title}</a>
          </strong>
          {post.data.description ? '：' + truncate(post.data.description, 80) : ''}
        </li>
      ))}
    </ul>
    <p class="cta-mini-wrap">
      <a href={ROUTES.blog} class="cta-mini">{viewAllText}</a>
    </p>
  </>
)}

<style>
  .cta-mini-wrap {
    margin-top: var(--space-4);
  }

  .empty-state {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .empty-state a,
  .cta-mini {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
    transition: color var(--t-base), text-decoration-color var(--t-base);
  }

  .empty-state a:hover,
  .cta-mini:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }
</style>
