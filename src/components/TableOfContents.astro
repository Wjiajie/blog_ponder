---
import type { MarkdownHeading } from '@astrojs/markdown-remark';

interface Props {
  headings: MarkdownHeading[];
  /**
   * `desktop` → renders the sticky list (caller puts it in the right aside).
   * `mobile`  → renders the floating action button + popover (caller puts it
   *             outside the right aside, since `position: fixed` inside a
   *             `transform: translateX(-100%)` ancestor positions relative
   *             to that ancestor instead of the viewport).
   */
  variant: 'desktop' | 'mobile';
  /**
   * Inclusive min heading depth to include (default 2 — skip the article H1).
   */
  minDepth?: number;
  /**
   * Inclusive max heading depth to include (default 3 — keeps the list
   * readable; raise to 4 if a post really needs it).
   */
  maxDepth?: number;
  /**
   * Copy for the "On this page" / "In this post" header.
   * Falls back to a sensible English default.
   */
  title?: string;
}

const {
  headings,
  variant,
  minDepth = 2,
  maxDepth = 3,
  title = '本文目录',
} = Astro.props;

const items = headings.filter(
  (h) => h.depth >= minDepth && h.depth <= maxDepth
);
---

{items.length > 0 && variant === 'desktop' && (
  <nav class="toc-aside" aria-label="文章目录">
    <div class="toc-header">
      <h3 class="section-subtitle toc-title">{title}</h3>
      <div class="toc-actions">
        <button
          type="button"
          class="toc-action"
          data-toc-top
          aria-label="回到文章顶部"
          title="回到文章顶部"
        >
          <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M10 16V4M4 10l6-6 6 6" />
          </svg>
        </button>
        <button
          type="button"
          class="toc-action"
          data-toc-theme
          aria-label="切换深色模式"
          title="切换深色模式"
        >
          <svg class="icon-light" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="icon-dark" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
      </div>
    </div>
    <ul class="toc-list" data-toc-list>
      {items.map((h) => (
        <li class:list={['toc-item', `toc-item--depth-${h.depth}`]}>
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            class="toc-link"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

{items.length > 0 && variant === 'mobile' && (
  <>
    <button
      type="button"
      class="toc-fab"
      data-toc-fab
      aria-label="打开目录"
      aria-expanded="false"
      aria-controls="toc-popover"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M3 5h14M3 10h10M3 15h14" />
      </svg>
    </button>

    <div
      id="toc-popover"
      class="toc-popover"
      data-toc-popover
      role="dialog"
      aria-label="文章目录"
      aria-modal="false"
      hidden
    >
      <div class="toc-header toc-popover-header">
        <h3 class="section-subtitle toc-title">{title}</h3>
        <div class="toc-actions">
          <button
            type="button"
            class="toc-action"
            data-toc-top
            aria-label="回到文章顶部"
            title="回到文章顶部"
          >
            <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M10 16V4M4 10l6-6 6 6" />
            </svg>
          </button>
          <button
            type="button"
            class="toc-action"
            data-toc-theme
            aria-label="切换深色模式"
            title="切换深色模式"
          >
            <svg class="icon-light" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
            <svg class="icon-dark" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
          <button
            type="button"
            class="toc-action toc-close"
            data-toc-close
            aria-label="关闭目录"
            title="关闭"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M5 5l10 10M15 5L5 15" />
            </svg>
          </button>
        </div>
      </div>
      <ul class="toc-list" data-toc-list>
        {items.map((h) => (
          <li class:list={['toc-item', `toc-item--depth-${h.depth}`]}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="toc-link"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </>
)}

<script is:inline>
  (function () {
    // Guard against double-init: when TableOfContents is rendered twice
    // (desktop + mobile variants), the component's <script> is emitted
    // twice and would attach two click handlers — clicking the FAB would
    // toggle the popover open then immediately closed, leaving it shut.
    if (window.__tocInited) return;
    window.__tocInited = true;

    function init() {
      var fab = document.querySelector('[data-toc-fab]');
      var popover = document.querySelector('[data-toc-popover]');
      if (!fab || !popover) return;

      var closeBtn = popover.querySelector('[data-toc-close]');

      function setOpen(open) {
        if (open) {
          popover.hidden = false;
          fab.setAttribute('aria-expanded', 'true');
        } else {
          popover.hidden = true;
          fab.setAttribute('aria-expanded', 'false');
        }
      }

      fab.addEventListener('click', function (e) {
        e.stopPropagation();
        setOpen(popover.hidden);
      });
      if (closeBtn) {
        closeBtn.addEventListener('click', function () { setOpen(false); });
      }

      // --- Action buttons inside the TOC chrome ---
      // "Top of post" buttons (one in the desktop aside, one in the
      // mobile popover). Smooth scroll to the article header.
      var topBtns = document.querySelectorAll('[data-toc-top]');
      for (var t = 0; t < topBtns.length; t++) {
        topBtns[t].addEventListener('click', function (e) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
          setOpen(false);
        });
      }

      // Theme toggle buttons. Mirror the same logic the floating
      // ThemeToggle component uses — toggle `.dark` on <html> and
      // persist to localStorage.
      var themeBtns = document.querySelectorAll('[data-toc-theme]');
      for (var th = 0; th < themeBtns.length; th++) {
        themeBtns[th].addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var isDark = document.documentElement.classList.toggle('dark');
          try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (_) { /* no-op */ }
          setOpen(false);
        });
      }

      // Close when a link is clicked (so we land on the heading, not behind the popover)
      var popLinks = popover.querySelectorAll('[data-toc-link]');
      for (var i = 0; i < popLinks.length; i++) {
        popLinks[i].addEventListener('click', function () { setOpen(false); });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !popover.hidden) setOpen(false);
      });

      document.addEventListener('click', function (e) {
        if (popover.hidden) return;
        var t = e.target;
        if (t.closest && (t.closest('[data-toc-popover]') || t.closest('[data-toc-fab]'))) return;
        setOpen(false);
      });

      // --- Active-section tracking via IntersectionObserver ---
      var allLinks = document.querySelectorAll('[data-toc-link]');
      if (!allLinks.length) return;

      // Build a slug -> [link, link, ...] index
      var linksBySlug = {};
      for (var k = 0; k < allLinks.length; k++) {
        var slug = allLinks[k].getAttribute('data-toc-link');
        if (!slug) continue;
        if (!linksBySlug[slug]) linksBySlug[slug] = [];
        linksBySlug[slug].push(allLinks[k]);
      }

      // Build an ordered list of { slug, el } for the headings we actually have links for
      var targets = [];
      var seen = {};
      for (var m = 0; m < allLinks.length; m++) {
        var s = allLinks[m].getAttribute('data-toc-link');
        if (!s || seen[s]) continue;
        seen[s] = true;
        var el = document.getElementById(s);
        if (el) targets.push({ slug: s, el: el });
      }
      if (!targets.length) return;

      function clearActive() {
        for (var n = 0; n < allLinks.length; n++) {
          allLinks[n].removeAttribute('data-active');
        }
      }
      function setActive(slug) {
        if (!slug) { clearActive(); return; }
        clearActive();
        var ls = linksBySlug[slug];
        if (!ls) return;
        for (var p = 0; p < ls.length; p++) {
          ls[p].setAttribute('data-active', 'true');
        }
      }

      if (!targets.length) return;

      // Compute the active section from raw rects. This is more reliable
      // than IntersectionObserver for two reasons: (1) IO doesn't fire
      // for the initial state and can miss entries on programmatic
      // scroll-jumps (scrollIntoView, anchor links), and (2) a single
      // rAF-throttled loop is simpler than reconciling a visible-set.
      var ticking = false;
      function computeActive() {
        // Active band: anything between the top of the viewport (with an
        // 80px header inset) and 60% of the viewport height. We pick the
        // LATEST heading whose top has scrolled into this band — i.e.
        // the heading the reader is most likely looking at right now.
        var vh = window.innerHeight;
        var activation = vh * 0.6;
        var active = null;
        for (var k = 0; k < targets.length; k++) {
          var top = targets[k].el.getBoundingClientRect().top;
          if (top <= activation) active = targets[k].slug;
          else break;
        }
        setActive(active);
      }
      function onScrollOrResize() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          computeActive();
        });
      }
      window.addEventListener('scroll', onScrollOrResize, { passive: true });
      window.addEventListener('resize', onScrollOrResize);
      // Initial paint — set the right active link before the user
      // touches anything.
      computeActive();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  /* ============================================================
     Shared list (used by both desktop aside and mobile popover)
     ============================================================ */
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border);
  }
  .toc-item {
    margin: 0;
  }
  .toc-link {
    display: block;
    padding: 4px var(--space-3);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: color var(--t-base), border-color var(--t-base);
  }
  .toc-link:hover {
    color: var(--text);
  }
  .toc-link[data-active='true'] {
    color: var(--text);
    font-weight: 500;
    border-left-color: var(--signal);
  }
  /* Depth-based indent */
  .toc-item--depth-2 .toc-link { padding-left: var(--space-3); }
  .toc-item--depth-3 .toc-link { padding-left: var(--space-6); }
  .toc-item--depth-4 .toc-link { padding-left: var(--space-8); }

  .toc-title {
    margin-bottom: var(--space-3);
  }

  /* Header strip — title on the left, action buttons on the right.
     Used by both the desktop aside and the mobile popover so the
     TOC panel is the single home for "Top" and "Theme" controls. */
  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .toc-header .toc-title {
    margin-bottom: 0;
  }
  .toc-popover-header {
    /* Slightly tighter spacing inside the popover; otherwise identical. */
    margin-bottom: var(--space-2);
  }

  .toc-actions {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .toc-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--text-subtle);
    cursor: pointer;
    border-radius: 4px;
    transition: color var(--t-base), background var(--t-base);
  }
  .toc-action:hover {
    color: var(--text);
    background: var(--bg-muted);
  }
  .toc-action:focus-visible {
    outline: 1px dotted var(--text-muted);
    outline-offset: 2px;
  }
  .toc-action svg {
    flex: none;
  }
  .toc-action .icon-dark { display: none; }
  :global(.dark) .toc-action .icon-light { display: none; }
  :global(.dark) .toc-action .icon-dark { display: block; }

  /* ============================================================
     Desktop: rendered inside the existing sticky right aside.
     Visible at >= 768px.
     ============================================================ */

  /* Cap the panel to the viewport and let the list scroll
     independently. Without this, a long list of headings pushes the
     panel past the viewport — and because the outer col-right is
     `position: sticky` (which only follows the page scroll, it does
     not scroll on its own), the items below the fold become
     unreachable: scrolling the article moves the panel out of view,
     and there is no way to scroll the panel itself. */
  .toc-aside {
    max-height: calc(100vh - 2 * var(--space-12));
    overflow-y: auto;
    /* Reserve a stable scrollbar gutter so the list width doesn't
       reflow when the OS-native scrollbar appears (Windows shows it
       always; macOS shows it on scroll). */
    scrollbar-gutter: stable;
  }
  /* Tame the scrollbar in line with the restrained chrome — thin,
     low-contrast thumb on a transparent track. */
  .toc-aside::-webkit-scrollbar {
    width: 6px;
  }
  .toc-aside::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-aside::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
  }
  .toc-aside::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
  }

  /* Keep the header (title + Top / Theme buttons) pinned to the top
     of the scrollable panel so they stay reachable no matter how far
     the reader scrolls within the list. The bg paint hides the
     list items as they pass behind the header. */
  .toc-aside > .toc-header {
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 1;
    /* A small bottom pad so the first list item doesn't crowd the
       divider line. */
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
  }

  @media (max-width: 767px) {
    .toc-aside {
      display: none;
    }
  }

  /* ============================================================
     Mobile: floating button + popover.
     Only shown at < 768px.

     The collapsed FAB is intentionally muted (low contrast, no
     shadow, smaller footprint) so it does not pull focus away from
     the article body. It only becomes "loud" on hover or while
     the popover is open. Stacks above the global theme toggle
     (~44px tall).
     ============================================================ */
  .toc-fab {
    display: none;
    position: fixed;
    bottom: calc(var(--space-6) + 48px + var(--space-3));
    right: var(--space-6);
    z-index: 25;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--text-subtle);
    cursor: pointer;
    opacity: 0.55;
    transition:
      color var(--t-base),
      background var(--t-base),
      border-color var(--t-base),
      opacity var(--t-base);
  }
  .toc-fab:hover,
  .toc-fab:focus-visible,
  .toc-fab[aria-expanded='true'] {
    color: var(--text);
    background: var(--bg);
    border-color: var(--border);
    opacity: 1;
  }

  .toc-popover {
    position: fixed;
    /* Sits above the FAB. 32px FAB + 8px gap. */
    bottom: calc(var(--space-6) + 32px + var(--space-2));
    right: var(--space-6);
    z-index: 25;
    width: 280px;
    max-width: calc(100vw - var(--space-6) * 2);
    max-height: 60vh;
    overflow-y: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: var(--space-3) var(--space-4) var(--space-4);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--text) 10%, transparent);
  }
  .toc-popover[hidden] {
    display: none;
  }
  /* (old .toc-popover-header / .toc-popover-close styles are gone —
     the header is now .toc-header + .toc-actions, defined above) */

  @media (max-width: 767px) {
    .toc-fab {
      display: inline-flex;
      bottom: calc(var(--space-4) + 32px + var(--space-2));
      right: var(--space-4);
    }
    .toc-popover {
      bottom: calc(var(--space-4) + 32px + var(--space-2) + 32px + var(--space-2));
      right: var(--space-4);
      max-width: calc(100vw - var(--space-4) * 2);
    }
  }
</style>
