---
import { getCollection } from 'astro:content';
import { ROUTES } from '../consts';

interface Props {
  title?: string;
  nextLabel?: string;
  viewTimelineText?: string;
}

const {
  title = '现在',
  nextLabel = '下一站',
  viewTimelineText = '→ 查看完整时间线',
} = Astro.props;

const phases = (await getCollection('journey')).sort(
  (a, b) => a.data.order - b.data.order,
);
const current = phases.find((p) => p.data.status === 'in-progress');
const next = phases.find((p) => p.data.status === 'upcoming');

const trimSentenceEnd = (text: string) => text.replace(/[。.]$/, '');
---

<section class="now-block">
  <h2 class="now-title">{title}</h2>
  <p class="now-line">
    <span class="now-label">{current?.data.month ?? '—'}</span>
    <span class="now-text">
      {current ? `进行中 · ${trimSentenceEnd(current.data.description)}` : '在两个阶段之间调整节奏'}
    </span>
  </p>
  {next && (
    <p class="now-line">
      <span class="now-label">{nextLabel}</span>
      <span class="now-text">
        {`目标在 ${next.data.month} 之前交付 ${next.data.outputs[0] ?? next.data.title}。`}
      </span>
    </p>
  )}
  <p class="now-cta">
    <a href={ROUTES.journey} class="cta-mini">{viewTimelineText}</a>
  </p>
</section>

<style>
  .now-block {
    margin-top: var(--space-12);
  }

  .now-title {
    font-size: var(--fs-2xl);
    font-weight: 500;
    margin: 0 0 var(--space-3) 0;
    letter-spacing: -0.02em;
  }

  .now-line {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .now-label {
    flex: 0 0 auto;
    min-width: 48px;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    letter-spacing: 0;
  }

  .now-text {
    color: var(--text);
    flex: 1 1 auto;
    min-width: 0;
  }

  .now-cta {
    margin-top: var(--space-4);
  }

  .cta-mini {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color var(--t-base), text-decoration-color var(--t-base);
  }

  .cta-mini:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }
</style>
