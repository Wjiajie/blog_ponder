---
import { NAV, SITE, ROUTES } from '../consts';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
// A "back to top" link in the mobile menu only makes sense on a long
// article page. We detect it by checking that the path is under the
// blog index but is not the blog index itself.
const isArticlePage =
  currentPath.startsWith(ROUTES.blog) && currentPath !== ROUTES.blog;
---

<header class="mobile-header">
  <a href={ROUTES.home} class="mobile-mark">{SITE.title}</a>
    <details class="mobile-menu">
      <summary aria-label="切换菜单">
      <svg
        class="icon-menu"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M3 6h14M3 10h14M3 14h14" />
      </svg>
      <svg
        class="icon-close"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M5 5l10 10M15 5L5 15" />
      </svg>
    </summary>
    <nav class="mobile-nav" aria-label="主导航">
      {isArticlePage && (
        <a href="#top" data-back-to-top>↑ 回到顶部</a>
      )}
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[{ 'is-active': currentPath === item.href }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </details>
</header>

<!--
  Floating hamburger (mobile only).
  Sits in the top-right corner so the menu stays reachable after the user
  has scrolled past the inline header. State is synced with the
  <details> element above via the data-mobile-menu-fab handler.
-->
<button
  type="button"
  class="mobile-menu-fab"
  data-mobile-menu-fab
  aria-label="打开菜单"
>
  <svg
    class="icon-menu"
    width="20"
    height="20"
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M3 6h14M3 10h14M3 14h14" />
  </svg>
  <svg
    class="icon-close"
    width="20"
    height="20"
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M5 5l10 10M15 5L5 15" />
  </svg>
</button>

<script is:inline>
  (function () {
    // "Back to top" link inside the popover menu — close the popover
    // first, then smooth-scroll. The two steps stay distinct so the
    // menu animation does not fight the scroll.
    document.addEventListener('click', function (e) {
      var link = e.target && e.target.closest && e.target.closest('[data-back-to-top]');
      if (!link) return;
      e.preventDefault();
      var details = link.closest('details');
      if (details) details.open = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Floating hamburger button — mirrors the <details> state. We
    // toggle programmatically instead of forwarding clicks, so the
    // inline <summary> and the FAB never desync.
    var fab = document.querySelector('[data-mobile-menu-fab]');
    if (fab) {
      fab.addEventListener('click', function () {
        var details = document.querySelector('details.mobile-menu');
        if (!details) return;
        details.open = !details.open;
        fab.setAttribute('aria-expanded', details.open ? 'true' : 'false');
        fab.setAttribute('aria-label', details.open ? '关闭菜单' : '打开菜单');
      });
    }

    // Reveal the FAB only after the user has scrolled past the
    // inline header. Uses rAF throttling so scroll listeners stay cheap.
    if (fab) {
      var ticking = false;
      var threshold = 80; // px of scroll before FAB fades in
      function update() {
        var y = window.scrollY || window.pageYOffset || 0;
        var visible = y > threshold;
        fab.classList.toggle('is-visible', visible);
        ticking = false;
      }
      window.addEventListener(
        'scroll',
        function () {
          if (!ticking) {
            window.requestAnimationFrame(update);
            ticking = true;
          }
        },
        { passive: true }
      );
      update();
    }
  })();
</script>

<style>
  .mobile-header {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-8);
    position: relative;
  }

  .mobile-mark {
    font-weight: 600;
    font-size: var(--fs-lg);
    text-decoration: none;
    color: var(--text);
  }

  /* The <details> element becomes the popover anchor */
  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    color: var(--text);
    border-radius: 4px;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  /* Swap icons based on open state — ☰ by default, ☓ when open */
  .mobile-menu .icon-close {
    display: none;
  }
  .mobile-menu[open] .icon-menu {
    display: none;
  }
  .mobile-menu[open] .icon-close {
    display: block;
  }

  /* Popover menu — fixed in the top-right corner, just below the
     FAB. Using fixed (not absolute) so the popover stays anchored
     to the FAB even after the inline header has scrolled out of view. */
  .mobile-nav {
    position: fixed;
    top: calc(var(--space-3) + 40px + var(--space-2));
    right: var(--space-3);
    min-width: 200px;
    display: flex;
    flex-direction: column;
    padding: var(--space-2) 0;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--text) 10%, transparent);
    z-index: 50;
  }

  .mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    font-style: italic;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--t-base), background var(--t-base);
  }

  .mobile-nav a:hover {
    color: var(--text);
    background: var(--bg-muted);
  }

  .mobile-nav a.is-active {
    color: var(--text);
    font-weight: 500;
    background: var(--bg-muted);
  }

  /* Floating hamburger — fixed in the top-right corner. Hidden on
     desktop and hidden at the top of the page; fades in once the
     user scrolls past the inline header. Visual weight matches the
     TOC FAB (transparent background, transparent border, low
     opacity) so chrome never competes with the article body. */
  .mobile-menu-fab {
    display: none;
    position: fixed;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 40;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--text-subtle);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      color var(--t-base),
      background var(--t-base),
      border-color var(--t-base);
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-menu-fab:hover,
  .mobile-menu-fab:focus-visible {
    color: var(--text);
    background: var(--bg);
    border-color: var(--border);
  }

  .mobile-menu-fab:focus-visible {
    outline: 1px dotted var(--text-muted);
    outline-offset: 2px;
  }

  .mobile-menu-fab.is-visible {
    opacity: 0.55;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-menu-fab.is-visible:hover,
  .mobile-menu-fab.is-visible:focus-visible {
    opacity: 1;
  }

  /* Mirror the inline hamburger's icon swap using the FAB's own
     aria-expanded state, so the visible icon matches the open popover. */
  .mobile-menu-fab .icon-close {
    display: none;
  }
  .mobile-menu-fab[aria-expanded="true"] .icon-menu {
    display: none;
  }
  .mobile-menu-fab[aria-expanded="true"] .icon-close {
    display: block;
  }

  @media (max-width: 767px) {
    .mobile-header {
      display: flex;
    }

    .mobile-menu-fab {
      display: inline-flex;
    }
  }
</style>
