---
import { getCollection } from 'astro:content';
import { ROUTES } from '../consts';
import copy from '../data/copy.json';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

// Pull the currently-in-progress milestone from the journey collection.
// If nothing is in-progress, fall back to the first upcoming one.
const phases = (await getCollection('journey')).sort(
  (a, b) => a.data.order - b.data.order
);
const current = phases.find((p) => p.data.status === 'in-progress');
const next = phases.find((p) => p.data.status === 'upcoming');

// Substitutions stay minimal — keep templates in copy.json, do the
// .replace() once at the call site so copy stays readable as English.
const nowCopy = copy.now;
const renderInProgress = (description: string) =>
  nowCopy.inProgressTemplate.replace('{description}', description.replace(/\.$/, ''));
const renderShip = (output: string, month: string) =>
  nowCopy.shipTemplate.replace('{output}', output).replace('{month}', month);
---

<section class="now-block">
  <h2 class="section-title">Now</h2>
  <p class="now-line">
    <span class="now-label">{current?.data.month ?? '—'}</span>
    <span class="now-text">
      {current ? renderInProgress(current.data.description) : nowCopy.restingText}
    </span>
  </p>
  {next && (
    <p class="now-line">
      <span class="now-label">Next</span>
      <span class="now-text">{renderShip(next.data.outputs[0] ?? next.data.title, next.data.month)}</span>
    </p>
  )}

  <div class="now-recent">
    <h3 class="section-subtitle">{nowCopy.latestTitle}</h3>
    <ul class="bullet-list">
      {posts.length === 0 && <li class="text-muted">No posts yet.</li>}
      {posts.map((p) => (
        <li>
          <a href={ROUTES.blogPost(p.slug)}>{p.data.title}</a>
        </li>
      ))}
    </ul>
    {posts.length > 0 && (
      <p style="margin-top: var(--space-4);">
        <a href={ROUTES.blog} class="cta-mini">{nowCopy.viewAllCta}</a>
      </p>
    )}
  </div>
</section>

<style>
  .now-line {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .now-label {
    flex: 0 0 auto;
    min-width: 48px;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .now-text {
    color: var(--text);
    flex: 1 1 auto;
    min-width: 0;
  }

  .now-recent {
    margin-top: var(--space-8);
  }

  .cta-mini {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color var(--t-base), text-decoration-color var(--t-base);
  }

  .cta-mini:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }
</style>
