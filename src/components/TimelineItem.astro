---
import { STATUS_META } from '../consts';

interface Props {
  month: string;
  title: string;
  status: 'done' | 'in-progress' | 'upcoming';
  description: string;
  outputs?: string[];
  links?: { label: string; href: string }[];
  isLast?: boolean;
}

const { month, title, status, description, outputs = [], links = [], isLast = false } = Astro.props;

const statusSymbol = STATUS_META.journey[status].symbol;
---

<div class="timeline-item">
  <div class="timeline-marker" data-status={status}>
    <span class="timeline-symbol">{statusSymbol}</span>
  </div>
  {!isLast && <div class="timeline-line" aria-hidden="true"></div>}

  <div class="timeline-content">
    <div class="timeline-meta">
      <span class="timeline-month">{month}</span>
      <h3 class="timeline-title">{title}</h3>
    </div>
    <p class="timeline-desc">{description}</p>

    {outputs.length > 0 && (
      <ul class="timeline-outputs">
        {outputs.map((o) => <li>{o}</li>)}
      </ul>
    )}

    {links.length > 0 && (
      <div class="timeline-links">
        {links.map((l) => (
          <a href={l.href} class="tag">→ {l.label}</a>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--space-4);
    position: relative;
    padding-bottom: var(--space-10);
  }

  .timeline-marker {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    z-index: 1;
  }

  .timeline-marker[data-status='done'] {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .timeline-marker[data-status='in-progress'] {
    border-color: var(--text);
    color: var(--text);
  }

  .timeline-line {
    position: absolute;
    left: 13px;
    top: 30px;
    bottom: 0;
    width: 1.5px;
    background: var(--border);
  }

  .timeline-content {
    min-width: 0;
  }

  .timeline-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .timeline-month {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    letter-spacing: 0;
    flex: 0 0 32px;
  }

  .timeline-title {
    font-size: var(--fs-lg);
    font-weight: 500;
    margin: 0;
  }

  .timeline-desc {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-3);
  }

  .timeline-outputs {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3) 0;
    font-size: var(--fs-sm);
  }

  .timeline-outputs li {
    position: relative;
    padding-left: var(--space-4);
    margin-bottom: var(--space-1);
    color: var(--text);
  }

  .timeline-outputs li::before {
    content: '·';
    position: absolute;
    left: var(--space-1);
    color: var(--text-muted);
    font-weight: 600;
  }

  .timeline-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
