---
import '../styles/global.css';
// KaTeX stylesheet for $$ / $ math rendering (added when remark-math + rehype-katex
// are wired in astro.config.mjs). Imported here so every page that uses the layout
// gets math styling without needing per-page imports.
import 'katex/dist/katex.min.css';
import Sidebar from '../components/Sidebar.astro';
import RightAside from '../components/RightAside.astro';
import MobileHeader from '../components/MobileHeader.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE, ROUTES } from '../consts';

interface Props {
  title?: string;
  description?: string;
  showRightAside?: boolean;
  bodyClass?: string;
  /** Optional override for the OG image. Auto-resolved from URL when omitted. */
  ogImage?: string;
  /** og:type — defaults to "website", set to "article" on blog post pages. */
  ogType?: 'website' | 'article';
  /** ISO date string for og:article:published_time */
  publishedTime?: string;
  /** Tags for og:article:tag */
  tags?: string[];
}

const {
  title,
  description = SITE.description,
  showRightAside = true,
  bodyClass,
  ogImage,
  ogType = 'website',
  publishedTime,
  tags = [],
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const currentPath = Astro.url.pathname;

// Resolve a default OG image from the URL when the caller didn't set one.
// Blog posts get their own per-slug PNG; everything else falls back to
// the static default card.
const resolvedOgImage = (() => {
  if (ogImage) return ogImage;
  const m = currentPath.match(/^\/blog\/([^/]+)\/?$/);
  if (m) return `/og/blog/${m[1]}.png`;
  return "/og-default.png";
})();

const canonicalUrl = new URL(currentPath, SITE.url).toString();
const ogImageUrl = new URL(resolvedOgImage, SITE.url).toString();
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#F5F1EA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16222B" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={SITE.title} />

    <!-- Open Graph (Facebook / LinkedIn / WeChat / Weibo) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale === "en" ? "en_US" : SITE.locale} />
    {publishedTime && <meta property="og:article:published_time" content={publishedTime} />}
    {tags.map((t) => <meta property="og:article:tag" content={t} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <!-- Favicon suite: adaptive SVG first, then classic ICO + PNG fallbacks. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-maskable-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <title>{fullTitle}</title>
  </head>
  <body class={bodyClass}>
    <div class="page">
      <MobileHeader currentPath={currentPath} />

      <div class:list={['layout', showRightAside ? 'layout-3col' : 'layout-2col']}>
        <Sidebar currentPath={currentPath} />

        <main class="col-main">
          <slot />
        </main>

        {showRightAside && <RightAside><slot name="aside" /></RightAside>}
      </div>

      <div class="theme-toggle-wrapper">
        <ThemeToggle />
      </div>
    </div>
  </body>
</html>

<style>
  .theme-toggle-wrapper {
    position: fixed;
    bottom: var(--space-6);
    right: var(--space-6);
    z-index: 10;
  }

  @media (max-width: 767px) {
    .theme-toggle-wrapper {
      bottom: var(--space-4);
      right: var(--space-4);
    }
  }
</style>
