---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from '@astrojs/markdown-remark';
import { FORMATTING, ROUTES, COPY } from '../consts';

type ArticleCollection = 'blog' | 'feeds';
type ArticleEntry = CollectionEntry<'blog'> | CollectionEntry<'feeds'>;

interface Props {
  entry: ArticleEntry;
  headings: MarkdownHeading[];
  collection?: ArticleCollection;
  /** A more recently published post — the "newer" / "next" arrow. */
  newer?: ArticleEntry | null;
  /** An older post — the "previous" arrow at the foot of the page. */
  older?: ArticleEntry | null;
  /** Posts that share at least one tag with the current post, capped at 3. */
  related?: ArticleEntry[];
}

const { entry, headings, collection = 'blog', newer = null, older = null, related = [] } = Astro.props;
const { title, description, pubDate, tags } = entry.data;
const postHref = (slug: string) =>
  collection === 'feeds' ? ROUTES.feedPost(slug) : ROUTES.blogPost(slug);
const relatedTitle = collection === 'feeds' ? '相关热点' : '相关随想';

const formattedDate = pubDate.toLocaleDateString(FORMATTING.locale, FORMATTING.dateLong);

// Rough reading time: words / wpm (see FORMATTING.readingWpm in consts.ts)
const wordCount = entry.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / FORMATTING.readingWpm));

// Short-date label used in prev/next + related footers. We render dates
// at the same muted color so the visual hierarchy stays consistent with
// the .article-row list at /blog/.
const shortDate = (d: Date) =>
  d
    .toLocaleDateString(FORMATTING.locale, FORMATTING.dateShort)
    .replace(/\//g, '.');

// Single source of truth for the TOC aside header — kept here (not in
// TableOfContents) so the layout is the one place to change it.
const asideTitle = COPY.article.asideTitle;
---

<BaseLayout
  title={title}
  description={description}
  showRightAside={true}
  bodyClass="article-reading"
  ogType="article"
  publishedTime={pubDate.toISOString()}
  tags={tags}
  hideSearch={true}
>
  <button
    class="article-nav-toggle"
    data-article-nav-toggle
    aria-label="显示导航"
    aria-expanded="false"
  >
    <svg class="icon-menu" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M3 6h14M3 10h14M3 14h14" />
    </svg>
    <svg class="icon-close" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" style="display:none">
      <path d="M5 5l10 10M15 5L5 15" />
    </svg>
  </button>

  <article class="article">
    <header class="article-header">
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span class="meta-sep">·</span>
        <span>{readingTime} 分钟阅读</span>
        {tags.length > 0 && (
          <>
            <span class="meta-sep">·</span>
            <span class="article-tags">
              {tags.map((t, i) => (
                <>
                  {i > 0 && ' '}
                  {collection === 'blog' ? (
                    <Tag href={ROUTES.blogTag(t)}>#{t}</Tag>
                  ) : (
                    <span class="article-tag-plain">#{t}</span>
                  )}
                </>
              ))}
            </span>
          </>
        )}
      </div>
    </header>

    <div class="article-body prose">
      <slot />
    </div>
  </article>

  {/* ============================================================
       Post-footer navigation — three blocks:
         1. "上一篇 / 下一篇" (newer / older) — text-only links with
            a small date beside each, aligned in a 2-column grid.
         2. "相关随想" (related) — list of up to 3 posts sharing a tag,
            rendered as a compact bullet list (the same Delba-style
            "· 项目名 : 一行描述" rhythm we use elsewhere).
       Both are visually subordinate to the body — the body remains
       the dominant element. We render only what's available so a
       single-post blog doesn't show empty boxes.
       ============================================================ */}
  {(newer || older) && (
    <nav class="article-nav" aria-label="上一篇 / 下一篇">
      {older ? (
        <a href={postHref(older.slug)} class="article-nav-link article-nav-link--prev">
          <span class="article-nav-direction">← 上一篇</span>
          <span class="article-nav-title">{older.data.title}</span>
          <span class="article-nav-date">{shortDate(older.data.pubDate)}</span>
        </a>
      ) : (
        <span class="article-nav-spacer" aria-hidden="true"></span>
      )}
      {newer ? (
        <a href={postHref(newer.slug)} class="article-nav-link article-nav-link--next">
          <span class="article-nav-direction">下一篇 →</span>
          <span class="article-nav-title">{newer.data.title}</span>
          <span class="article-nav-date">{shortDate(newer.data.pubDate)}</span>
        </a>
      ) : (
        <span class="article-nav-spacer" aria-hidden="true"></span>
      )}
    </nav>
  )}

  {related.length > 0 && (
    <aside class="article-related" aria-label={relatedTitle}>
      <h3 class="article-related-title">{relatedTitle}</h3>
      <ul class="bullet-list">
        {related.map((p) => (
          <li>
            <strong><a href={postHref(p.slug)}>{p.data.title}</a></strong>
            <span class="article-related-date">{shortDate(p.data.pubDate)}</span>
          </li>
        ))}
      </ul>
    </aside>
  )}

  <Fragment slot="aside">
    <TableOfContents
      variant="desktop"
      headings={headings}
      title={asideTitle}
    />
  </Fragment>

  {/* Mobile TOC (FAB + popover). Rendered outside the right aside slot
      because position: fixed inside col-right's transform: translateX(...)
      would otherwise anchor the FAB to the aside instead of the viewport. */}
  <TableOfContents
    variant="mobile"
    headings={headings}
    title={asideTitle}
  />
</BaseLayout>

<script is:inline>
  (function () {
    function init() {
      var body = document.body;
      var btn = document.querySelector('[data-article-nav-toggle]');
      if (!btn || !body) return;

      var iconMenu = btn.querySelector('.icon-menu');
      var iconClose = btn.querySelector('.icon-close');

      function setState(state) {
        body.dataset.articleNav = state;
        btn.setAttribute('aria-expanded', state === 'visible' ? 'true' : 'false');
        btn.setAttribute('aria-label', state === 'visible' ? '隐藏导航' : '显示导航');
        if (iconMenu) iconMenu.style.display = state === 'visible' ? 'none' : '';
        if (iconClose) iconClose.style.display = state === 'visible' ? '' : 'none';
      }

      // Nav toggle is now strictly a side-panel toggle — no scroll
      // side-effect. "Top of post" lives inside the TOC panel
      // (see TableOfContents.astro) so reading flow and navigation
      // are no longer bundled into a single click.
      btn.addEventListener('click', function () {
        var next = body.dataset.articleNav === 'visible' ? 'hidden' : 'visible';
        setState(next);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && body.dataset.articleNav === 'visible') {
          setState('hidden');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<script>
  // Image lightbox — medium-zoom attaches click-to-zoom to every <img>
  // inside the article body. ESC / click-outside / scroll past threshold
  // all close the zoom — all built into the library, no custom state
  // machine to maintain.
  //
  // We pull the dark/light background from the design tokens (via
  // getComputedStyle) so the overlay matches the active theme. A
  // MutationObserver re-attaches when client-side navigation swaps
  // in fresh images.
  import mediumZoom from 'medium-zoom';

  function readBg() {
    return getComputedStyle(document.body).getPropertyValue('--bg').trim() || '#fff';
  }

  function init() {
    let zoom: ReturnType<typeof mediumZoom> | null = null;

    function start() {
      if (zoom) return; // already attached
      const root = document.querySelector('.article-body');
      if (!root) return;
      const imgs = root.querySelectorAll('img');
      if (imgs.length === 0) return;
      zoom = mediumZoom(Array.from(imgs), {
        background: readBg(),
        margin: 24,
        scrollOffset: 40,
      });
    }

    start();

    // Re-attach after client-side view transitions (Astro <ClientRouter />)
    // swap in fresh article images. MutationObserver is the safe
    // fallback when the view transition event isn't available.
    document.addEventListener('astro:page-load', () => {
      if (zoom) {
        zoom.detach();
        zoom = null;
      }
      start();
    });

    if (typeof MutationObserver !== 'undefined') {
      const mo = new MutationObserver(() => {
        // Only refresh if new images have been added that we haven't
        // already attached to.
        if (!zoom) {
          start();
          return;
        }
        const root = document.querySelector('.article-body');
        if (!root) return;
        const attached = new Set(zoom.getImages());
        const fresh = Array.from(root.querySelectorAll('img')).filter(
          (img) => !attached.has(img)
        );
        if (fresh.length > 0) zoom.attach(fresh);
      });
      mo.observe(document.body, { childList: true, subtree: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .article-header {
    margin-bottom: var(--space-12);
  }

  .article-header::after {
    content: '';
    display: block;
    width: 44px;
    height: 1px;
    margin-top: var(--space-4);
    background: var(--signal);
    opacity: 0.7;
  }

  .article-title {
    /* Pin article H1 to 32px — independent of --fs-3xl which has been
       retuned smaller for non-article page heroes (see global.css). */
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
    text-wrap: balance;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .meta-sep {
    color: var(--text-subtle);
  }

  .article-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .article-tag-plain {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .article-body :global(h2) {
    margin-top: var(--space-16);
    margin-bottom: var(--space-4);
    /* Pin prose H2 to the original (24px) size even if global --fs-2xl is
       tuned smaller for list / index pages — keeps Lee Robinson prose feel. */
    font-size: 24px;
    letter-spacing: -0.02em;
  }

  .article-body :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    /* Same rationale as h2 above: pin prose H3 to 20px. */
    font-size: 20px;
  }

  .article-body :global(p) {
    margin-bottom: var(--space-6);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .article-body :global(ul) {
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(li) {
    margin-bottom: var(--space-2);
    padding-left: var(--space-1);
  }

  .article-body :global(li::marker) {
    color: var(--text-muted);
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: var(--space-8) 0;
    border: 1px solid var(--border);
    background: var(--bg-muted);
    cursor: zoom-in;
    transition: opacity var(--t-base), border-color var(--t-base);
  }

  .article-body :global(img:hover) {
    opacity: 0.92;
  }

  /* Image caption (rendered by the zoomable component or by raw
     markdown image-with-title syntax) — sit just under the image,
     centered, in muted italic. */
  .article-body :global(figure) {
    margin: var(--space-8) 0;
  }

  .article-body :global(figure img) {
    margin: 0 0 var(--space-3) 0;
  }

  .article-body :global(figcaption) {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-align: center;
    font-style: italic;
    line-height: 1.5;
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-8) 0;
    font-size: var(--fs-sm);
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .article-body :global(th) {
    font-weight: 600;
    color: var(--text);
  }

  .article-body :global(hr) {
    margin: var(--space-12) 0;
  }

  /* ============================================================
     Post-footer navigation (prev/next + related)
     ============================================================
     Visually subordinate to the body. Same shud.in dot-leader
     rhythm as /blog/ rows: 2-column grid, text-only, the "newer"
     side aligns right, dates use --text-subtle. No card, no border,
     no shadow — just a generous margin separating footer from body. */
  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .article-nav-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: var(--text);
    line-height: 1.4;
  }
  .article-nav-link--prev { text-align: left; }
  .article-nav-link--next { text-align: right; }

  .article-nav-direction {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: none;       /* explicit: no uppercase even if global
                                   .section-subtitle ever flips back */
  }
  .article-nav-title {
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: text-decoration-color var(--t-base);
  }
  .article-nav-link:hover .article-nav-title {
    text-decoration-color: var(--text);
  }
  .article-nav-date {
    font-size: var(--fs-xs);
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
  }

  /* Spacer keeps the grid balanced when only one direction is present
     (e.g. the very newest post has no "older" link). */
  .article-nav-spacer {
    display: block;
  }

  /* Related-posts block — reuses the global .bullet-list styling so it
     stays in the same family as the project list on the home page. */
  .article-related {
    margin-top: var(--space-12);
  }
  .article-related-title {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0;
    margin: 0 0 var(--space-4) 0;
  }
  .article-related-date {
    margin-left: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--text-subtle);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 600px) {
    /* On phones, prev/next stack to one line each so the title doesn't
       wrap awkwardly inside a 1-col grid. */
    .article-nav {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .article-nav-link--next { text-align: left; }
  }
</style>

<style is:global>
  /* Reading mode: hide sidebars by default, surface via floating toggle */
  @media (min-width: 768px) {
    body.article-reading .page {
      max-width: 1040px;
    }

    body.article-reading .layout-3col {
      display: block;
    }

    body.article-reading .layout-3col > .col-main {
      max-width: min(100%, 47rem);
      margin: 0 auto;
    }

    body.article-reading .col-left,
    body.article-reading .col-right {
      position: fixed;
      top: var(--space-12);
      width: var(--sidebar-w);
      max-height: calc(100vh - var(--space-24));
      overflow: auto;
    }

    body.article-reading .col-left {
      left: var(--space-8);
      transform: translateX(-120%);
    }

    body.article-reading .col-right {
      right: var(--space-8);
      width: var(--aside-w);
      transform: translateX(120%);
    }
  }

  body.article-reading .col-left,
  body.article-reading .col-right {
    opacity: 0;
    pointer-events: none;
  }

  body.article-reading[data-article-nav="visible"] .col-left,
  body.article-reading[data-article-nav="visible"] .col-right {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* On article pages, theme switching lives inside the TOC panel
     (TableOfContents.astro renders the [data-toc-theme] button).
     Hide the floating wrapper so the two UIs do not compete. */
  body.article-reading .theme-toggle-wrapper {
    display: none;
  }

  .col-left,
  .col-right {
    transition: transform 250ms ease, opacity 200ms ease;
  }

  .article-nav-toggle {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 30;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--text-subtle);
    cursor: pointer;
    opacity: 0.55;
    transition:
      color var(--t-base),
      background var(--t-base),
      border-color var(--t-base),
      opacity var(--t-base);
  }

  .article-nav-toggle:hover,
  .article-nav-toggle:focus-visible {
    color: var(--text);
    background: var(--bg);
    border-color: var(--border);
    opacity: 1;
  }

  body.article-reading[data-article-nav="visible"] .article-nav-toggle {
    color: var(--text);
    background: var(--bg);
    border-color: var(--border);
    opacity: 1;
  }

  /* Mobile already has hamburger; hide this duplicate */
  @media (max-width: 767px) {
    .article-nav-toggle {
      display: none;
    }
  }

  /* medium-zoom overlay & zoomed image — pin above the TOC FAB
     (z-index 30) and the article nav toggle (z-index 30) so the
     lightbox always wins the stacking context. The library's default
     is z-index 999, which is already higher; we set it explicitly
     here so future z-index changes to the page chrome don't
     accidentally cover the zoom. */
  :global(.medium-zoom-overlay),
  :global(.medium-zoom-image--opened) {
    z-index: 50;
  }

  /* ============================================================
     Responsive tables in article body
     ============================================================
     The hot-info daily report (and any future prose table) renders
     5-7 column tables on desktop. On phones (< 640px) those tables
     collapse to <50px per column, which is unusable.

     The data-label is set by a small inline script at the bottom
     of this layout (see "Mobile table hydration" below): on DOM
     ready, it walks every <table> in .article-body, reads the
     column header from <th>, and copies it onto each <td> as
     data-label. Then this CSS rewrites the table to a stack of
     cards: each row is a card, each cell is "label : value".

     Desktop (>= 640px) is untouched — the table stays a real table.

     The breakpoint is 640px (not the 767px used for layout) because
     the 5-col "标题 / 来源 / 分类 / 时间 / 摘要" hot-info table
     starts breaking around 640px, well before the sidebar hides. */
  @media (max-width: 639px) {
    .article-body table {
      display: block;
      width: 100%;
      border: 0;
      margin: var(--space-6) 0;
    }

    .article-body thead {
      /* Column names render via td::before on each row. Hide the
         header row entirely so it doesn't show as an empty card. */
      display: none;
    }

    .article-body tbody,
    .article-body tr {
      display: block;
      width: 100%;
    }

    .article-body tbody tr {
      display: block;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: var(--space-2) var(--space-3);
      margin-bottom: var(--space-4);
      background: var(--bg);
    }

    /* Last row gets no trailing gap before the next section. */
    .article-body tbody tr:last-child {
      margin-bottom: 0;
    }

    .article-body tbody td {
      display: grid;
      grid-template-columns: 80px 1fr;
      align-items: baseline;
      gap: var(--space-3);
      padding: var(--space-2) 0;
      border-bottom: 1px dashed var(--border);
      text-align: left;
      font-size: var(--fs-sm);
      line-height: 1.55;
    }

    .article-body tbody td:last-child {
      border-bottom: 0;
    }

    /* The label comes from the <th> text, injected by the
       hydration script. Muting it preserves the visual hierarchy
       (label is metadata, value is the content). */
    .article-body tbody td::before {
      content: attr(data-label);
      color: var(--text-muted);
      font-size: var(--fs-xs);
      font-weight: 500;
      letter-spacing: 0.02em;
      text-align: left;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* First column ("#") — narrow numeric id, no label needed */
    .article-body tbody td:first-child {
      grid-template-columns: 1fr;
      padding-bottom: 0;
      border-bottom: 0;
      color: var(--text-subtle);
      font-variant-numeric: tabular-nums;
      font-size: var(--fs-xs);
    }
    .article-body tbody td:first-child::before {
      content: "";
    }

    /* Long-link cells: keep the value on one line up to a sensible
       point, then ellipsis. The lightbox won't reach into cards
       (no <img>), so this is safe. */
    .article-body tbody td a {
      color: var(--text);
      text-decoration: underline;
      text-decoration-color: var(--border);
      text-underline-offset: 2px;
    }
    .article-body tbody td a:hover {
      text-decoration-color: var(--text);
    }
  }
</style>

<script is:inline>
  /* Mobile table hydration
     ------------------------
     Walks every <table> in .article-body, reads the column header
     from <th>, and copies it onto each <td> as data-label. The CSS
     in @media (max-width: 639px) above uses [data-label] to render
     column names as a leading pseudo-element on each cell.

     This runs once on load and again after any Astro view transition
     (astro:page-load) so the cards stay in sync on client-side nav.

     No-op for tables without <th> (rare, e.g. hand-written <tr><td>).
     Safe to run on every page — it scopes to .article-body only. */
  (function () {
    function hydrateTables() {
      var root = document.querySelector('.article-body');
      if (!root) return;
      var tables = root.querySelectorAll('table');
      for (var i = 0; i < tables.length; i++) {
        var t = tables[i];
        var ths = t.querySelectorAll('thead th');
        if (ths.length === 0) continue;
        var labels = [];
        for (var k = 0; k < ths.length; k++) {
          labels.push((ths[k].textContent || '').trim());
        }
        var rows = t.querySelectorAll('tbody tr');
        for (var r = 0; r < rows.length; r++) {
          var tds = rows[r].querySelectorAll('td');
          for (var c = 0; c < tds.length && c < labels.length; c++) {
            if (labels[c] && !tds[c].getAttribute('data-label')) {
              tds[c].setAttribute('data-label', labels[c]);
            }
          }
        }
      }
    }
    function init() {
      hydrateTables();
    }
    document.addEventListener('astro:page-load', init);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
