---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from '@astrojs/markdown-remark';
import { FORMATTING, ROUTES } from '../consts';
import copy from '../data/copy.json';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description, pubDate, tags } = entry.data;

const formattedDate = pubDate.toLocaleDateString(FORMATTING.locale, FORMATTING.dateLong);

// Rough reading time: words / wpm (see FORMATTING.readingWpm in consts.ts)
const wordCount = entry.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / FORMATTING.readingWpm));

const articleCopy = copy.article;
---

<BaseLayout
  title={title}
  description={description}
  showRightAside={true}
  bodyClass="article-reading"
  ogType="article"
  publishedTime={pubDate.toISOString()}
  tags={tags}
>
  <button
    class="article-nav-toggle"
    data-article-nav-toggle
    aria-label="Show navigation"
    aria-expanded="false"
  >
    <svg class="icon-menu" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M3 6h14M3 10h14M3 14h14" />
    </svg>
    <svg class="icon-close" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" style="display:none">
      <path d="M5 5l10 10M15 5L5 15" />
    </svg>
  </button>

  <article class="article">
    <header class="article-header">
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span class="meta-sep">·</span>
        <span>{readingTime} min read</span>
        {tags.length > 0 && (
          <>
            <span class="meta-sep">·</span>
            <span class="article-tags">
              {tags.map((t, i) => (
                <>
                  {i > 0 && ' '}
                  <Tag href={ROUTES.blogTag(t)}>#{t}</Tag>
                </>
              ))}
            </span>
          </>
        )}
      </div>
    </header>

    <div class="article-body prose">
      <slot />
    </div>
  </article>

  <Fragment slot="aside">
    <TableOfContents
      variant="desktop"
      headings={headings}
      title={articleCopy.asideTitle}
    />
  </Fragment>

  {/* Mobile TOC (FAB + popover). Rendered outside the right aside slot
      because position: fixed inside col-right's transform: translateX(...)
      would otherwise anchor the FAB to the aside instead of the viewport. */}
  <TableOfContents
    variant="mobile"
    headings={headings}
    title={articleCopy.asideTitle}
  />
</BaseLayout>

<script is:inline>
  (function () {
    function init() {
      var body = document.body;
      var btn = document.querySelector('[data-article-nav-toggle]');
      if (!btn || !body) return;

      var iconMenu = btn.querySelector('.icon-menu');
      var iconClose = btn.querySelector('.icon-close');

      function setState(state) {
        body.dataset.articleNav = state;
        btn.setAttribute('aria-expanded', state === 'visible' ? 'true' : 'false');
        btn.setAttribute('aria-label', state === 'visible' ? 'Hide navigation' : 'Show navigation');
        if (iconMenu) iconMenu.style.display = state === 'visible' ? 'none' : '';
        if (iconClose) iconClose.style.display = state === 'visible' ? '' : 'none';
      }

      // Nav toggle is now strictly a side-panel toggle — no scroll
      // side-effect. "Top of post" lives inside the TOC panel
      // (see TableOfContents.astro) so reading flow and navigation
      // are no longer bundled into a single click.
      btn.addEventListener('click', function () {
        var next = body.dataset.articleNav === 'visible' ? 'hidden' : 'visible';
        setState(next);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && body.dataset.articleNav === 'visible') {
          setState('hidden');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .article-header {
    margin-bottom: var(--space-12);
  }

  .article-title {
    font-size: var(--fs-3xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .meta-sep {
    color: var(--text-subtle);
  }

  .article-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .article-body :global(h2) {
    margin-top: var(--space-16);
    margin-bottom: var(--space-4);
  }

  .article-body :global(h3) {
    margin-top: var(--space-10);
    margin-bottom: var(--space-3);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-6);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: var(--space-8) 0;
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-8) 0;
    font-size: var(--fs-sm);
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .article-body :global(th) {
    font-weight: 600;
    color: var(--text);
  }

  .article-body :global(hr) {
    margin: var(--space-12) 0;
  }
</style>

<style is:global>
  /* Reading mode: hide sidebars by default, surface via floating toggle */
  body.article-reading .col-left,
  body.article-reading .col-right {
    transform: translateX(-100%);
    opacity: 0;
    pointer-events: none;
  }

  body.article-reading[data-article-nav="visible"] .col-left,
  body.article-reading[data-article-nav="visible"] .col-right {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* On article pages, theme switching lives inside the TOC panel
     (TableOfContents.astro renders the [data-toc-theme] button).
     Hide the floating wrapper so the two UIs do not compete. */
  body.article-reading .theme-toggle-wrapper {
    display: none;
  }

  .col-left,
  .col-right {
    transition: transform 250ms ease, opacity 200ms ease;
  }

  .article-nav-toggle {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 30;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--text-subtle);
    cursor: pointer;
    opacity: 0.55;
    transition:
      color var(--t-base),
      background var(--t-base),
      border-color var(--t-base),
      opacity var(--t-base);
  }

  .article-nav-toggle:hover,
  .article-nav-toggle:focus-visible {
    color: var(--text);
    background: var(--bg);
    border-color: var(--border);
    opacity: 1;
  }

  body.article-reading[data-article-nav="visible"] .article-nav-toggle {
    color: var(--text);
    background: var(--bg);
    border-color: var(--border);
    opacity: 1;
  }

  /* Mobile already has hamburger; hide this duplicate */
  @media (max-width: 767px) {
    .article-nav-toggle {
      display: none;
    }
  }
</style>
