---
// Home page is now content-driven: src/content/pages/home.mdx owns
// the markup (hero / project list / post list / "now" block) and
// this file is just the layout shell + right-rail about-card.
//
// To edit the home page, open home.mdx — not this file.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIAL } from '../consts';

const entry = await getEntry('pages', 'home');
if (!entry) {
  throw new Error('Missing content entry: pages/home');
}
const { Content } = await entry.render();
---

<BaseLayout
  title={undefined}
  description={SITE.description}
  showRightAside={true}
>
  <Content />

  <Fragment slot="aside">
    <section class="about-card">
      <h2 class="about-title">{entry.data.aside?.title ?? 'About me'}</h2>
      <div class="about-head">
        <div class="about-avatar" aria-hidden="true">J</div>
        <p class="about-body">{entry.data.aside?.body}</p>
      </div>
      <hr class="about-divider" />
      <div class="about-links">
        {SOCIAL.map((s, i) => (
          <>
            <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{s.label}</a>
            {i < SOCIAL.length - 1 && <span class="sep">·</span>}
          </>
        ))}
      </div>
    </section>
  </Fragment>
</BaseLayout>

<style>
  /* The home.mdx markup is responsible for its own rhythm
     (.delba-section / .page-title / etc. live there). This file
     only owns the right-rail about-card, which is layout-shared
     chrome rather than content. Keeping the styles here means
     home.mdx can be edited by a non-engineer without touching
     this file. */

  /* Right column About-me card — keep title small and unornamented
     (no borders, no uppercase, no separator line). */
  :global(.col-right) .about-title {
    font-size: var(--fs-sm);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    margin: 0 0 var(--space-3) 0;
    color: var(--text-muted);
  }

  :global(.col-right) .about-divider {
    /* divider removed visually; markup is preserved for stability */
    border: 0;
    margin: 0;
    height: 0;
  }
</style>
