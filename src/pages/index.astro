---
import BaseLayout from '../layouts/BaseLayout.astro';
import Now from '../components/Now.astro';
import { SITE, ROUTES } from '../consts';
import { getCollection } from 'astro:content';
import copy from '../data/copy.json';

const phases = (await getCollection('journey')).sort(
  (a, b) => a.data.order - b.data.order
);
const doneCount = phases.filter((p) => p.data.status === 'done').length;
const totalCount = phases.length;

const homeCopy = copy.home;

// Split a template on {name} so we can wrap that slot in <span class="hero-name">.
// {placeholder}→value substitution is a pure string transform; the JSX wrapping
// is a structural concern, so it lives in the .astro file.
const renderGreeting = (template: string) => {
  const [before = '', after = ''] = template.split('{name}');
  return { before, after };
};
const renderSub = (shortBio: string, vertical: string, company: string) =>
  homeCopy.heroSubTemplate
    .replace('{shortBio}', shortBio)
    .replace('{vertical}', vertical)
    .replace('{company}', company);
const renderPreviewBody = (done: number, total: number) =>
  homeCopy.journeyPreviewBodyTemplate
    .replace('{doneCount}', String(done))
    .replace('{totalCount}', String(total));

const greeting = renderGreeting(homeCopy.heroGreetingTemplate);
---

<BaseLayout
  title={undefined}
  description={SITE.description}
  showRightAside={false}
>
  <section class="hero">
    <h1 class="hero-title">
      {greeting.before}<span class="hero-name">{SITE.author}</span>{greeting.after}
    </h1>
    <p class="hero-sub">
      {renderSub(SITE.shortBio, SITE.vertical, SITE.targetCompany)}
    </p>
  </section>

  <Now />

  <section class="journey-preview">
    <h2 class="section-title">{homeCopy.journeyPreviewTitle}</h2>
    <p class="text-muted" style="font-size: var(--fs-sm); margin-bottom: var(--space-6);">
      {renderPreviewBody(doneCount, totalCount)}
    </p>
    <a href={ROUTES.journey} class="cta-link">{homeCopy.journeyPreviewCta}</a>
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: var(--space-16);
  }

  .hero-title {
    font-size: var(--fs-3xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .hero-name {
    font-style: italic;
    color: var(--text-muted);
  }

  .hero-sub {
    font-size: var(--fs-lg);
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 540px;
  }

  .hero-sub strong {
    color: var(--text);
    font-weight: 500;
  }

  .cta-link {
    display: inline-block;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    font-size: var(--fs-sm);
    transition: text-decoration-color var(--t-base);
  }

  .cta-link:hover {
    text-decoration-color: var(--text);
  }
</style>
