---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ROUTES } from '../../consts';

export async function getStaticPaths() {
 const projects = (await getCollection('projects'));
 return projects.map((project) => ({
 params: { slug: project.slug },
 props: { entry: project },
 }));
}

interface Props {
 entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout
 title={entry.data.title}
 description={entry.data.summary}
 showRightAside={true}
>
 <article class="project-detail">
 <p class="eyebrow">project</p>
 <h1 class="page-title">{entry.data.title}</h1>
 <p class="page-lead">{entry.data.summary}</p>

 {(entry.data.stack.length >0 || Object.keys(entry.data.links).length >0) && (
 <p class="page-meta">
 {entry.data.stack.length >0 && (
 <span class="meta-block">
 <span class="meta-label">stack</span>
 <span class="meta-value">
 {entry.data.stack.map((s, i) => (
 <>
 {i >0 && <span class="sep" aria-hidden="true">·</span>}
 <code>{s}</code>
 </>
 ))}
 </span>
 </span>
 )}
 {Object.keys(entry.data.links).length >0 && (
 <span class="meta-block">
 <span class="meta-label">links</span>
 <span class="meta-value">
 {entry.data.links.demo && <a href={entry.data.links.demo} target="_blank" rel="noopener noreferrer">在线</a>}
 {entry.data.links.repo && <a href={entry.data.links.repo} target="_blank" rel="noopener noreferrer">源码</a>}
 {entry.data.links.post && <a href={entry.data.links.post}>笔记</a>}
 </span>
 </span>
 )}
 </p>
 )}

 <hr />

 <div class="project-body prose">
 <Content />
 </div>

 <p class="back-link">
 <a href={ROUTES.projects}>←回到所有项目</a>
 </p>
 </article>

 <Fragment slot="aside">
 <section class="aside-block">
 <h3 class="aside-title">项目状态</h3>
 <p class="aside-body">
 {entry.data.status === 'shipped' && '已上线。有可演示的工件。'}
 {entry.data.status === 'in-progress' && '持续迭代中,每周有可衡量的进展。'}
 {entry.data.status === 'planning' && '规划阶段:先把最小链路跑通,再叠加更多能力。'}
 {entry.data.status === 'archived' && '已归档:保留作为参考,不再投入精力。'}
 </p>
 </section>
 </Fragment>
</BaseLayout>

<style>
 /* ==================================================================
 Page header — 与列表页保持一致的收敛字号
 ================================================================== */
 .page-title {
 font-size:22px;
 font-weight:500;
 color: var(--text);
 letter-spacing: -0.02em;
 line-height:1.25;
 margin:0;
 text-wrap: balance;
 }

 .eyebrow {
 font-size:12px;
 color: var(--text-subtle);
 font-style: italic;
 letter-spacing:0;
 text-transform: none; /*覆盖 global kicker 的 uppercase */
 margin:0020px0;
 }

 .page-lead {
 color: var(--text-muted);
 font-size:15px;
 line-height:1.6;
 max-width:38em;
 margin:20px08px;
 text-wrap: pretty;
 }

 /* ==================================================================
 Meta line — stack + links同一行,小字、subtle
 ================================================================== */
 .page-meta {
 display: flex;
 flex-wrap: wrap;
 align-items: baseline;
 gap:24px;
 font-size:13px;
 color: var(--text-muted);
 margin:8px00;
 }

 .meta-block {
 display: inline-flex;
 align-items: baseline;
 gap:8px;
 }

 .meta-label {
 color: var(--text-subtle);
 font-style: italic;
 font-size:12px;
 }

 .meta-value {
 display: inline-flex;
 align-items: baseline;
 flex-wrap: wrap;
 gap:0;
 color: var(--text-muted);
 }

 .meta-value code {
 font-size:12px;
 color: var(--text-muted);
 background: transparent;
 padding:0;
 border-radius:0;
 }

 .meta-value .sep {
 color: var(--text-subtle);
 margin:00.5em;
 user-select: none;
 }

 .meta-value a {
 color: var(--text-muted);
 text-decoration: underline;
 text-decoration-color: var(--border);
 text-underline-offset:2px;
 transition: color150ms ease, text-decoration-color150ms ease;
 }

 .meta-value a:hover {
 color: var(--text);
 text-decoration-color: var(--text);
 }

 /* ==================================================================
 Body — Lee Robinson排版 (1px hr分隔)
 ================================================================== */
 .project-body :global(p) {
 line-height:1.7;
 }

 .project-body :global(h2) {
 font-size:18px;
 font-weight:500;
 letter-spacing: -0.01em;
 margin-top:48px;
 margin-bottom:16px;
 text-wrap: balance;
 }

 .project-body :global(h3) {
 font-size:16px;
 font-weight:500;
 letter-spacing:0;
 margin-top:32px;
 margin-bottom:12px;
 text-wrap: balance;
 }

 .project-body :global(hr) {
 border:0;
 border-top:1px solid var(--border);
 margin:40px0;
 }

 /* ==================================================================
 Back link
 ================================================================== */
 .back-link {
 margin-top:56px;
 font-size:13px;
 color: var(--text-muted);
 }

 .back-link a {
 color: var(--text-muted);
 text-decoration: underline;
 text-decoration-color: var(--border);
 text-underline-offset:2px;
 transition: color150ms ease, text-decoration-color150ms ease;
 }

 .back-link a:hover {
 color: var(--text);
 text-decoration-color: var(--text);
 }

 /* ==================================================================
 Aside
 ================================================================== */
 .aside-block {
 margin-bottom:32px;
 }

 .aside-title {
 font-size:13px;
 font-weight:500;
 color: var(--text);
 letter-spacing:0;
 text-transform: none;
 margin:0012px0;
 }

 .aside-body {
 font-size:13px;
 line-height:1.65;
 color: var(--text-muted);
 }

 /* ==================================================================
 Responsive
 ================================================================== */
 @media (max-width:767px) {
 .page-title { font-size:20px; }
 .page-lead { font-size:15px; }
 .page-meta { gap:16px; font-size:13px; }
 }
</style>
