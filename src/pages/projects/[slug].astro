---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ROUTES } from '../../consts';

export async function getStaticPaths() {
  const projects = (await getCollection('projects'));
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { entry: project },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  showRightAside={true}
>
  <article class="project-detail">
    <p class="kicker">— Project</p>
    <h1 class="project-title">{entry.data.title}</h1>
    <p class="project-summary">{entry.data.summary}</p>

    {entry.data.stack.length > 0 && (
      <p class="project-stack">
        {entry.data.stack.map((s, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
            <code>{s}</code>
          </>
        ))}
      </p>
    )}

    {Object.keys(entry.data.links).length > 0 && (
      <p class="project-links">
        {entry.data.links.demo && <a href={entry.data.links.demo} target="_blank" rel="noopener noreferrer">在线 →</a>}
        {entry.data.links.repo && <a href={entry.data.links.repo} target="_blank" rel="noopener noreferrer">源码 →</a>}
        {entry.data.links.post && <a href={entry.data.links.post}>相关笔记 →</a>}
      </p>
    )}

    <hr />

    <div class="project-body prose">
      <Content />
    </div>

    <p class="back-link">
      <a href={ROUTES.projects}>← 回到所有项目</a>
    </p>
  </article>

  <Fragment slot="aside">
    <section class="aside-block">
      <h3 class="section-subtitle">项目状态</h3>
      <p class="text-muted" style="font-size: var(--fs-sm); line-height: 1.7;">
        {entry.data.status === 'shipped' && '已上线。有可演示的工件。'}
        {entry.data.status === 'in-progress' && '持续迭代中，每周有可衡量的进展。'}
        {entry.data.status === 'planning' && '规划阶段：先把最小链路跑通，再叠加更多能力。'}
        {entry.data.status === 'archived' && '已归档：保留作为参考，不再投入精力。'}
      </p>
    </section>
  </Fragment>
</BaseLayout>

<style>
  .project-detail {
    max-width: 640px;
  }

  .kicker {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-subtle);
    margin: 0 0 var(--space-4) 0;
  }

  .project-title {
    font-size: var(--fs-3xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3) 0;
  }

  .project-summary {
    color: var(--text-muted);
    font-size: var(--fs-lg);
    line-height: 1.55;
    margin: 0 0 var(--space-6) 0;
    max-width: 36em;
  }

  .project-stack {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-4) 0;
  }

  .project-stack code {
    font-size: var(--fs-sm);
    background: transparent;
    padding: 0;
  }

  .project-stack .sep {
    color: var(--text-subtle);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-6) 0;
  }

  .project-links a {
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
  }

  .project-links a:hover {
    color: var(--text);
    border-bottom-color: var(--text);
  }

  .project-body :global(p) {
    line-height: 1.7;
  }

  .back-link {
    margin-top: var(--space-12);
    font-size: var(--fs-sm);
  }

  .back-link a {
    color: var(--text-muted);
  }

  .back-link a:hover {
    color: var(--text);
  }

  @media (max-width: 767px) {
    .project-title {
      font-size: var(--fs-2xl);
    }

    .project-summary {
      font-size: var(--fs-base);
    }
  }
</style>
