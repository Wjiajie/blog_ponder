---
// /feeds/ — a true calendar view for collected hot-info articles only.
// Feeds are intentionally separated from personal blog posts:
//   - content lives in src/content/feeds/
//   - detail pages live at /feeds/<slug>/
//   - /blog/ only shows personal notes and essays.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PAGE_META, ROUTES } from '../../consts';

const feedItems = (await getCollection('feeds'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const toIsoDate = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

const items = feedItems.map((item) => ({
  slug: item.slug,
  href: ROUTES.feedPost(item.slug),
  title: item.data.title,
  description: item.data.description ?? '',
  date: toIsoDate(item.data.pubDate),
  year: item.data.pubDate.getFullYear(),
  month: item.data.pubDate.getMonth() + 1,
  day: item.data.pubDate.getDate(),
  tags: item.data.tags,
}));

const latest = items[0];
const today = new Date();
const defaultYear = latest?.year ?? today.getFullYear();
const defaultMonth = latest?.month ?? today.getMonth() + 1;
const years = Array.from(new Set(items.map((item) => item.year))).sort((a, b) => b - a);
if (!years.includes(defaultYear)) years.unshift(defaultYear);

const monthLabels = [
  '一月',
  '二月',
  '三月',
  '四月',
  '五月',
  '六月',
  '七月',
  '八月',
  '九月',
  '十月',
  '十一月',
  '十二月',
];

const weekdayLabels = ['一', '二', '三', '四', '五', '六', '日'];
const itemsJson = JSON.stringify(items).replace(/</g, '\\u003c');
const yearOptionsJson = JSON.stringify(years).replace(/</g, '\\u003c');
---

<BaseLayout
  title={PAGE_META.feeds.title}
  description={PAGE_META.feeds.description}
  showRightAside={true}
>
  <header class="page-header">
    <h1>热点</h1>
    <p class="text-muted feed-lede">
      只展示我收集的热点信息。随想、项目复盘和个人文章不会出现在这里。
    </p>
  </header>

  <section class="calendar-shell" data-feed-calendar>
    <div class="calendar-controls" aria-label="选择年月">
      <label class="calendar-field">
        <span>年份</span>
        <select id="feed-year" aria-label="选择年份">
          {years.map((year) => (
            <option value={year} selected={year === defaultYear}>{year}</option>
          ))}
        </select>
      </label>

      <label class="calendar-field">
        <span>月份</span>
        <select id="feed-month" aria-label="选择月份">
          {monthLabels.map((label, index) => (
            <option value={index + 1} selected={index + 1 === defaultMonth}>{label}</option>
          ))}
        </select>
      </label>

      <button type="button" class="calendar-jump" id="feed-latest">最新</button>
    </div>

    <div class="calendar-heading">
      <h2 id="feed-calendar-title">{defaultYear} 年 {defaultMonth} 月</h2>
      <p id="feed-calendar-summary" class="calendar-summary" aria-live="polite"></p>
    </div>

    <div class="calendar-weekdays" aria-hidden="true">
      {weekdayLabels.map((w) => <span>{w}</span>)}
    </div>

    <ol class="calendar-grid" id="feed-grid" aria-label="热点信息日历"></ol>
  </section>

  <Fragment slot="aside">
    <section class="aside-block">
      <h3 class="section-subtitle">范围</h3>
      <p class="aside-copy">
        {items.length} 篇热点信息，来自 <code>src/content/feeds</code>。
      </p>
    </section>
  </Fragment>

  <script is:inline define:vars={{
    itemsJson,
    yearOptionsJson,
    defaultYear,
    defaultMonth,
  }}>
    const feedItems = JSON.parse(itemsJson);
    const availableYears = JSON.parse(yearOptionsJson);
    const yearSelect = document.getElementById('feed-year');
    const monthSelect = document.getElementById('feed-month');
    const latestButton = document.getElementById('feed-latest');
    const grid = document.getElementById('feed-grid');
    const title = document.getElementById('feed-calendar-title');
    const summary = document.getElementById('feed-calendar-summary');

    const byDate = feedItems.reduce((acc, item) => {
      (acc[item.date] ||= []).push(item);
      return acc;
    }, {});

    const pad = (n) => String(n).padStart(2, '0');
    const monthName = (m) => `${m} 月`;
    const readParams = () => {
      const params = new URLSearchParams(window.location.search);
      const monthParam = params.get('month');
      if (!monthParam) return { year: defaultYear, month: defaultMonth };
      const [year, month] = monthParam.split('-').map(Number);
      if (!year || !month || month < 1 || month > 12) {
        return { year: defaultYear, month: defaultMonth };
      }
      return { year, month };
    };

    const setUrl = (year, month) => {
      const url = new URL(window.location.href);
      url.searchParams.set('month', `${year}-${pad(month)}`);
      window.history.replaceState({}, '', url);
    };

    const render = (year, month) => {
      yearSelect.value = String(year);
      monthSelect.value = String(month);
      title.textContent = `${year} 年 ${monthName(month)}`;
      grid.innerHTML = '';

      const first = new Date(year, month - 1, 1);
      const startOffset = (first.getDay() + 6) % 7;
      const start = new Date(year, month - 1, 1 - startOffset);
      let visibleCount = 0;

      for (let i = 0; i < 42; i += 1) {
        const d = new Date(start);
        d.setDate(start.getDate() + i);

        const iso = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
        const inMonth = d.getMonth() + 1 === month;
        const posts = byDate[iso] || [];
        visibleCount += inMonth ? posts.length : 0;

        const cell = document.createElement('li');
        cell.className = [
          'calendar-cell',
          inMonth ? 'is-current-month' : 'is-adjacent-month',
          posts.length ? 'has-feed' : '',
        ].filter(Boolean).join(' ');
        cell.dataset.date = iso;

        if (posts.length) {
          const post = posts[0];
          const label = posts.length === 1
            ? `${iso}: ${post.title}`
            : `${iso}: ${posts.length} 篇热点信息，打开第一篇：${post.title}`;
          cell.innerHTML = `
            <a class="calendar-day calendar-day-link" href="${post.href}" aria-label="${escapeHtml(label)}" title="${escapeHtml(label)}">
              <span class="calendar-day-num">${d.getDate()}</span>
              <span class="calendar-feed-dot" aria-hidden="true"></span>
              <span class="sr-only">${escapeHtml(post.title)}</span>
            </a>
          `;
        } else {
          const day = document.createElement('div');
          day.className = 'calendar-day';
          day.innerHTML = `<span class="calendar-day-num">${d.getDate()}</span>`;

          cell.appendChild(day);
        }

        grid.appendChild(cell);
      }

      summary.textContent = visibleCount
        ? `${visibleCount} 篇热点信息，有蓝点的日期可点击阅读。`
        : '这个月还没有收集到热点信息。';
      setUrl(year, month);
    };

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    const initial = readParams();
    if (!availableYears.includes(initial.year)) {
      const option = document.createElement('option');
      option.value = String(initial.year);
      option.textContent = String(initial.year);
      yearSelect.appendChild(option);
    }

    render(initial.year, initial.month);

    yearSelect.addEventListener('change', () => {
      render(Number(yearSelect.value), Number(monthSelect.value));
    });
    monthSelect.addEventListener('change', () => {
      render(Number(yearSelect.value), Number(monthSelect.value));
    });
    latestButton.addEventListener('click', () => {
      render(defaultYear, defaultMonth);
    });
  </script>
</BaseLayout>

<style>
  .feed-lede {
    font-size: var(--fs-sm);
    margin-top: var(--space-2);
    max-width: 38em;
  }

  .calendar-shell {
    margin-top: var(--space-8);
    --feed-dot: var(--signal);
  }

  .calendar-controls {
    display: flex;
    align-items: end;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .calendar-field {
    display: inline-flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .calendar-field select {
    min-width: 112px;
    min-height: 36px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-sm);
    padding: 0 var(--space-2);
  }

  .calendar-jump {
    min-height: 36px;
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    cursor: pointer;
  }

  .calendar-jump:hover {
    color: var(--text);
    background: var(--bg-muted);
  }

  .calendar-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .calendar-heading h2 {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: 500;
    letter-spacing: 0;
  }

  .calendar-summary {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .calendar-weekdays,
  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .calendar-weekdays {
    border-bottom: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: var(--fs-xs);
    padding-bottom: var(--space-2);
    text-align: center;
  }

  .calendar-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    row-gap: var(--space-1);
  }

  .calendar-shell :global(.calendar-cell) {
    min-height: 48px;
  }

  .calendar-shell :global(.calendar-day),
  .calendar-shell :global(.calendar-day-link) {
    display: flex;
    min-height: 48px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 4px;
    padding: 6px 0;
    color: inherit;
    border-radius: 4px;
    text-decoration: none;
  }

  .calendar-shell :global(.calendar-day-num) {
    color: var(--text-subtle);
    font-size: var(--fs-sm);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .calendar-shell :global(.is-adjacent-month) {
    opacity: 0.42;
  }

  .calendar-shell :global(.is-adjacent-month .calendar-day-num) {
    color: var(--text-subtle);
  }

  .calendar-shell :global(.has-feed .calendar-day-num) {
    color: var(--text);
    font-weight: 500;
  }

  .calendar-shell :global(.calendar-day-link:hover) {
    background: var(--bg-muted);
  }

  .calendar-shell :global(.calendar-day-link:hover .calendar-day-num) {
    text-decoration: underline;
    text-decoration-color: var(--text-subtle);
    text-underline-offset: 3px;
  }

  .calendar-shell :global(.calendar-feed-dot) {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--feed-dot);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--feed-dot) 12%, transparent);
  }

  .calendar-shell :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .aside-copy {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  @media (max-width: 767px) {
    .calendar-controls {
      align-items: stretch;
      flex-wrap: wrap;
    }

    .calendar-field {
      flex: 1 1 120px;
    }

    .calendar-field select,
    .calendar-jump {
      width: 100%;
    }

    .calendar-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-1);
    }

    .calendar-shell :global(.calendar-cell),
    .calendar-shell :global(.calendar-day),
    .calendar-shell :global(.calendar-day-link) {
      min-height: 44px;
    }
  }
</style>
