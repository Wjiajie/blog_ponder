---
// /feeds/ — 日历视图,按月份展示所有 blog 文章。
// 每月一张 7 列网格月历,有文章的日期高亮 + 可点击跳到文章页。
// 设计目标:克制 / 文字优先,沿用 shud.in + rurikon 8 档灰度调色板。
// 关键约束:
//   1. 不动 global.css(那是设计契约),所有样式 page-scoped。
//   2. 纯静态:SSG 阶段就把所有 post slug 编译进 HTML,无客户端 fetch。
//   3. 当前月份 / 上个月 / 下个月 三个月并排展示,提供 ⟵ / ⟶ 切换按钮。
//   4. 没有文章的日期显示为细微 muted 数字,有文章的日期显示为黑色粗体 +
//      鼠标悬停出现小圆点,点击跳转到 /blog/{slug}/。

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PAGE_META, ROUTES } from '../../consts';

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Build a lookup: 'YYYY-MM-DD' -> { slug, title, description, tags }
// 用 pubDate 的本地日期(去掉时区)作为 key,Astro 默认 pubDate 是 Date 对象。
const postsByDate: Record<string, { slug: string; title: string; description?: string; tags: string[] }[]> = {};
for (const post of allPosts) {
  const d = post.data.pubDate;
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  if (!postsByDate[key]) postsByDate[key] = [];
  postsByDate[key].push({
    slug: post.id.replace(/\.mdx?$/, ''),
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags,
  });
}

// 抓 URL 查询参数 ?month=YYYY-MM,Astro 静态站点下 query 在 build 时为空,
// 所以默认显示"最新一篇文章所在月份"。客户端再用 JS 同步 ?month= 切换。
const latestPost = allPosts[0];
const defaultYear = latestPost ? latestPost.data.pubDate.getFullYear() : new Date().getFullYear();
const defaultMonth = latestPost ? latestPost.data.pubDate.getMonth() + 1 : new Date().getMonth() + 1;

const url = Astro.url;
const queryMonth = url.searchParams.get('month');
const [qy, qm] = queryMonth ? queryMonth.split('-').map(Number) : [defaultYear, defaultMonth];
const viewYear = qy || defaultYear;
const viewMonth = qm || defaultMonth;

// Generate the 3 months we display: prev, current, next.
const monthsToShow: { year: number; month: number; label: string }[] = [];
for (let offset = -1; offset <= 1; offset++) {
  const d = new Date(viewYear, viewMonth - 1 + offset, 1);
  const y = d.getFullYear();
  const m = d.getMonth() + 1;
  const label = `${y} 年 ${m} 月`;
  monthsToShow.push({ year: y, month: m, label });
}

// Build the calendar grid for a given year/month.
// 返回 6 行 x 7 列 = 42 格,前补上月末尾的空格,后补下月开头的空格。
function buildCalendar(year: number, month: number) {
  const firstDay = new Date(year, month - 1, 1);
  const lastDay = new Date(year, month, 0);
  const daysInMonth = lastDay.getDate();
  // JS getDay(): 0 = Sun, 1 = Mon ... 6 = Sat
  // 我们的日历从周一开始,所以 Mon=0 ... Sun=6。
  const startOffset = (firstDay.getDay() + 6) % 7;
  const cells: { date: number | null; iso: string | null; posts: { slug: string; title: string }[] }[] = [];
  for (let i = 0; i < startOffset; i++) {
    cells.push({ date: null, iso: null, posts: [] });
  }
  for (let d = 1; d <= daysInMonth; d++) {
    const iso = `${year}-${String(month).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    cells.push({
      date: d,
      iso,
      posts: postsByDate[iso] ?? [],
    });
  }
  // 补齐到 42 格
  while (cells.length < 42) {
    cells.push({ date: null, iso: null, posts: [] });
  }
  return cells;
}

const calendars = monthsToShow.map((m) => ({
  ...m,
  cells: buildCalendar(m.year, m.month),
}));

const today = new Date();
const todayIso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

// Total post count (for the header stat)
const totalCount = allPosts.length;
const yearSpan = allPosts.length > 0
  ? `${allPosts[allPosts.length - 1].data.pubDate.getFullYear()}–${allPosts[0].data.pubDate.getFullYear()}`
  : '—';

// 客户端:点击 ⟵ / ⟶ 切换月份,把目标月份塞进 ?month=YYYY-MM 触发整页 reload。
// 因为是 SSG + 静态站,query 切换必须走 reload,不能用 pushState。
// 用户的浏览器历史就能记录"翻到哪一月",后退按钮也能用。
const clientScript = `
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const current = params.get('month') || '';
    const [y, m] = current ? current.split('-').map(Number) : [${defaultYear}, ${defaultMonth}];
    const prev = new Date(y, m - 2, 1);
    const next = new Date(y, m, 1);
    const fmt = (d) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
    const prevBtn = document.getElementById('feeds-prev');
    const nextBtn = document.getElementById('feeds-next');
    const todayBtn = document.getElementById('feeds-today');
    if (prevBtn) prevBtn.addEventListener('click', () => {
      window.location.search = '?month=' + fmt(prev);
    });
    if (nextBtn) nextBtn.addEventListener('click', () => {
      window.location.search = '?month=' + fmt(next);
    });
    if (todayBtn) todayBtn.addEventListener('click', () => {
      const t = new Date();
      window.location.search = '?month=' + fmt(t);
    });
  });
`;

const weekdayLabels = ['一', '二', '三', '四', '五', '六', '日'];
---

<BaseLayout
  title="Feeds"
  description="按日历查看所有文章。"
  showRightAside={true}
>
  <header class="page-header">
    <h1>Feeds</h1>
    <p class="text-muted" style="font-size: var(--fs-sm); margin-top: var(--space-2);">
      {totalCount} 篇文章,{yearSpan}。每个有内容的日期都可点开。
    </p>
  </header>

  <div class="feeds-toolbar">
    <button type="button" id="feeds-prev" class="feeds-nav" aria-label="上个月">⟵</button>
    <span class="feeds-current">
      {viewYear} 年 {viewMonth} 月
    </span>
    <button type="button" id="feeds-next" class="feeds-nav" aria-label="下个月">⟶</button>
    <button type="button" id="feeds-today" class="feeds-today">回到今天</button>
  </div>

  <div class="feeds-calendars">
    {calendars.map((cal) => (
      <section class="feeds-calendar" data-month={`${cal.year}-${String(cal.month).padStart(2, '0')}`}>
        <h2 class="feeds-calendar-title">{cal.label}</h2>
        <div class="feeds-weekdays" aria-hidden="true">
          {weekdayLabels.map((w) => <span>{w}</span>)}
        </div>
        <ol class="feeds-grid">
          {cal.cells.map((cell) => (
            <li class:list={[
              'feeds-cell',
              cell.iso && postsByDate[cell.iso] && 'has-post',
              cell.iso === todayIso && 'is-today',
            ]}>
              {cell.posts.length > 0 ? (
                cell.posts.map((p) => (
                  <a
                    href={ROUTES.blogPost(p.slug)}
                    class="feeds-day feeds-day-linked"
                    title={p.title}
                  >
                    <span class="feeds-day-num">{cell.date}</span>
                    <span class="feeds-day-title">{p.title}</span>
                  </a>
                ))
              ) : cell.date !== null ? (
                <span class="feeds-day feeds-day-empty">
                  <span class="feeds-day-num">{cell.date}</span>
                </span>
              ) : (
                <span class="feeds-day feeds-day-blank" aria-hidden="true"></span>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <script set:html={clientScript} is:inline></script>
</BaseLayout>

<style>
  /* Page-scoped styles — 不动 global.css,以保持设计契约。
     全部使用现有的 design token (--text, --text-muted, --text-subtle,
     --border, --accent, --space-*),与 shud.in + rurikon 风格一致。 */

  .feeds-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-8) 0;
    font-size: var(--fs-sm);
  }

  .feeds-nav {
    appearance: none;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    width: 32px;
    height: 32px;
    border-radius: 0;
    cursor: pointer;
    font-size: var(--fs-base);
    line-height: 1;
    transition: background var(--t-fast), color var(--t-fast);
  }

  .feeds-nav:hover {
    background: var(--bg-muted);
  }

  .feeds-current {
    font-weight: 500;
    color: var(--text);
    min-width: 7em;
    text-align: center;
  }

  .feeds-today {
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    margin-left: auto;
    padding: 0;
  }

  .feeds-today:hover {
    color: var(--text);
  }

  .feeds-calendars {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .feeds-calendar-title {
    font-size: var(--fs-lg);
    font-weight: 500;
    margin: 0 0 var(--space-3) 0;
    color: var(--text);
    letter-spacing: 0;
  }

  .feeds-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0;
    font-size: var(--fs-xs);
    color: var(--text-subtle);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .feeds-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0;
  }

  .feeds-cell {
    min-height: 64px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: var(--space-2) var(--space-2);
    font-size: var(--fs-sm);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .feeds-cell:nth-child(7n) {
    border-right: 0;
  }

  .feeds-day {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: inherit;
  }

  .feeds-day-num {
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }

  .feeds-day-empty .feeds-day-num {
    color: var(--text-subtle);
    opacity: 0.5;
  }

  .feeds-day-blank {
    visibility: hidden;
  }

  .feeds-day-linked {
    color: var(--text);
    position: relative;
  }

  .feeds-day-linked .feeds-day-num {
    color: var(--text);
    font-weight: 500;
  }

  .feeds-day-linked::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text);
    opacity: 0;
    transition: opacity var(--t-fast);
  }

  .feeds-day-linked:hover {
    background: var(--bg-muted);
  }

  .feeds-day-linked:hover::before {
    opacity: 1;
  }

  .feeds-day-title {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .feeds-cell.is-today .feeds-day-num {
    color: var(--text);
    font-weight: 600;
  }

  .feeds-cell.is-today {
    background: var(--bg-muted);
  }

  /* Mobile: 月度之间堆叠更紧凑 */
  @media (max-width: 720px) {
    .feeds-cell {
      min-height: 56px;
      padding: var(--space-1);
    }
    .feeds-day-title {
      display: none;
    }
  }
</style>
