---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineItem from '../components/TimelineItem.astro';

const phases = [
  {
    month: 'M1',
    title: 'Foundation — LLM + AI Coding',
    status: 'done' as const,
    description: 'Built the LLM fundamentals + AI-augmented engineering muscle.',
    outputs: ['LLM model comparison report', 'AI Coding bug-pattern notebook'],
  },
  {
    month: 'M2',
    title: 'Foundation — RAG + Frontend',
    status: 'done' as const,
    description: 'Shipped a RAG question-answering web app end-to-end.',
    outputs: ['RAG web app on MiniMax / OpenAI APIs'],
  },
  {
    month: 'M3',
    title: 'Core — Agent + Evaluation',
    status: 'in-progress' as const,
    description: 'Going deep on LangGraph agents, MCP, and RAGAS evaluation.',
    outputs: ['Multi-agent teaching assistant', 'RAGAS evaluation report'],
  },
  {
    month: 'M4',
    title: 'Core — Fine-tuning + Multimodal + Edu Project 1',
    status: 'upcoming' as const,
    description: 'LoRA fine-tuning, voice + LLM, and the first K12 demo.',
    outputs: ['AI 学科 Agent 助教 MVP'],
  },
  {
    month: 'M5',
    title: 'Sprint — 3 Education Projects + Portfolio',
    status: 'upcoming' as const,
    description: 'Two more end-to-end demos, polished portfolio site.',
    outputs: ['Smart learning diagnostics', '3D immersive learning scene'],
  },
  {
    month: 'M6',
    title: 'Apply — Resume, Referral, Interview',
    status: 'upcoming' as const,
    description: 'Mock interviews, referrals, onsites.',
    outputs: ['Live portfolio at /', '5+ warm intros to MiniMax FDE'],
  },
];
---

<BaseLayout
  title="Journey"
  description="6-month ramp into a Forward Deployed Engineer role."
  showRightAside={true}
  rightAsideVariant="minimal"
>
  <header class="journey-header">
    <h1>FDE 转型路径</h1>
    <p class="text-muted" style="font-size: var(--fs-sm); margin-top: var(--space-2);">
      6 months. From "graphics + AI" to "ship AI in classrooms". Two phases done, one in progress.
    </p>
  </header>

  <div class="timeline">
    {phases.map((p, i) => (
      <TimelineItem
        month={p.month}
        title={p.title}
        status={p.status}
        description={p.description}
        outputs={p.outputs}
        isLast={i === phases.length - 1}
      />
    ))}
  </div>

  <Fragment slot="aside">
    <section class="aside-block">
      <h3 class="section-subtitle">At a glance</h3>
      <p class="text-muted" style="font-size: var(--fs-sm);">
        <strong style="color: var(--text);">3 / 6</strong> months done.<br />
        Currently in <strong style="color: var(--text);">M3</strong>.
      </p>
    </section>
    <section class="aside-block">
      <h3 class="section-subtitle">Next</h3>
      <p class="text-muted" style="font-size: var(--fs-sm);">
        Ship M4 demo: AI 学科 Agent 助教.
      </p>
    </section>
  </Fragment>
</BaseLayout>

<style>
  .journey-header {
    margin-bottom: var(--space-12);
  }

  .timeline {
    margin-top: var(--space-8);
  }
</style>
