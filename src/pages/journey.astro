---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { getCollection } from 'astro:content';
import { PAGE_META } from '../consts';
import copy from '../data/copy.json';

// All data lives in src/content/journey/. To add a new month, create a new .md file.
const phases = (await getCollection('journey'))
  .sort((a, b) => a.data.order - b.data.order);

// Derived stats — never hand-counted
const totalCount = phases.length;
const doneCount = phases.filter((p) => p.data.status === 'done').length;
const current = phases.find((p) => p.data.status === 'in-progress') ?? phases[doneCount];
const next = phases.find((p) => p.data.status === 'upcoming');

const journeyCopy = copy.journey;
const intro = journeyCopy.introTemplate
  .replace('{doneCount}', String(doneCount))
  .replace('{totalCount}', String(totalCount));
---

<BaseLayout
  title={PAGE_META.journey.title}
  description={PAGE_META.journey.description}
  showRightAside={true}
>
  <header class="journey-header">
    <h1>{journeyCopy.title}</h1>
    <p class="text-muted" style="font-size: var(--fs-sm); margin-top: var(--space-2);">
      {intro}
    </p>
  </header>

  <div class="timeline">
    {phases.map((p, i) => (
      <TimelineItem
        month={p.data.month}
        title={p.data.title}
        status={p.data.status}
        description={p.data.description}
        outputs={p.data.outputs}
        links={p.data.links}
        isLast={i === phases.length - 1}
      />
    ))}
  </div>

  <Fragment slot="aside">
    <section class="aside-block">
      <h3 class="section-subtitle">概览</h3>
      <p class="text-muted" style="font-size: var(--fs-sm);">
        已完成 <strong style="color: var(--text);">{doneCount} / {totalCount}</strong> 个阶段。<br />
        {current && <>当前在 <strong style="color: var(--text);">{current.data.month}</strong>。</>}
      </p>
    </section>
    {next && (
      <section class="aside-block">
        <h3 class="section-subtitle">下一站</h3>
        <p class="text-muted" style="font-size: var(--fs-sm);">
          {next.data.title}：{next.data.description}
        </p>
      </section>
    )}
  </Fragment>
</BaseLayout>

<style>
  .journey-header {
    margin-bottom: var(--space-12);
  }

  .timeline {
    margin-top: var(--space-8);
  }
</style>
