---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PAGE_META, ROUTES, STATUS_META } from '../consts';
import copy from '../data/copy.json';

// Always render all projects; filter is done client-side via JS
const all = (await getCollection('projects'))
 .sort((a, b) => a.data.order - b.data.order);

// Derive categories from the collection (no hardcoded list)
const categories = Array.from(new Set(all.map((p) => p.data.category))).sort();

// Render a project status as `${symbol} ${label}`, falling back to the raw
// status string if a new enum value is added before STATUS_META is updated.
const formatProjectStatus = (s: string): string => {
 const meta = STATUS_META.project[s as keyof typeof STATUS_META.project];
 return meta ? `${meta.symbol} ${meta.label}` : s;
};

const projectsCopy = copy.projects;
const filterHintTemplate = projectsCopy.filterHintTemplate;
const filterAllLabel = projectsCopy.filterAllLabel;

// Pre-render a stable, sortable token — category is already a string in
// the frontmatter; we just need to uppercase nothing and let CSS handle
// typography. Date-shaped placeholder retained for symmetry with the
// shud.in thoughts list (kept as a "01/02/03" marker for now).
const indexFor = (order: number) => String(order).padStart(2, '0');
---

<BaseLayout
 title={PAGE_META.projects.title}
 description={PAGE_META.projects.description}
 showRightAside={true}
>
 <header class="page-header">
 <h1 class="page-title">项目</h1>
 <p class="page-lead">
 三件正在并行推进的事。每一个都是为「在客户现场独立交付生产代码」这一目标打磨出来的可演示工件。
 <span id="filter-hint" class="filter-hint hidden"></span>
 </p>
 </header>

 <section class="project-section">
 <h2 id="filter-heading" class="section-heading filter-heading">{filterAllLabel}</h2>

 <ol class="project-list" role="list">
 {all.map((p) => (
 <li class="project-item" data-category={p.data.category}>
 <a href={ROUTES.project(p.slug)} class="project-row">
 <span class="project-title">{p.data.title}</span>
 <span class="leader" aria-hidden="true"></span>
 <span class="project-meta">
 <span class="project-status" data-status={p.data.status}>{formatProjectStatus(p.data.status)}</span>
 <span class="project-cat">{p.data.category}</span>
 </span>
 </a>

 <p class="project-summary">{p.data.summary}</p>
 </li>
 ))}
 </ol>

 <p id="empty-state" class="empty-state hidden">
 这个分类下还没有项目 — <a href={ROUTES.projects}>查看全部</a>。
 </p>
 </section>

 <Fragment slot="aside">
 <section class="aside-block">
 <h3 class="aside-title">分类</h3>
 <ul class="filter-list">
 <li>
 <a id="filter-all" href={ROUTES.projects} class="filter-link is-active">
 {filterAllLabel}
 <span class="filter-count">{all.length}</span>
 </a>
 </li>
 {categories.map((c) => {
 const count = all.filter((p) => p.data.category === c).length;
 return (
 <li>
 <a
 id={`filter-${c}`}
 href={ROUTES.projectCategory(c)}
 class="filter-link"
 >
 {c}
 <span class="filter-count">{count}</span>
 </a>
 </li>
 );
 })}
 </ul>
 </section>

 <section class="aside-block">
 <h3 class="aside-title">关于</h3>
 <p class="aside-body">
 这些项目的存在只有一个目的:证明我可以把 AI 在真实场景里端到端交付。每一条都从「客户痛点」开始,到「可演示的工件」结束。
 </p>
 </section>
 </Fragment>
</BaseLayout>

<script is:inline define:vars={{ filterHintTemplate }}>
 // Client-side category filter — works on static build.
 // filterHintTemplate is server-injected so the hint copy stays in copy.json.
 const params = new URLSearchParams(window.location.search);
 const activeCategory = params.get('category') || '';

 function applyFilter(cat) {
 const items = document.querySelectorAll('.project-item');
 const heading = document.getElementById('filter-heading');
 const hint = document.getElementById('filter-hint');
 const emptyState = document.getElementById('empty-state');

 let visible =0;
 items.forEach((item) => {
 const match = !cat || item.dataset.category === cat;
 item.style.display = match ? '' : 'none';
 if (match) visible++;
 });

 heading.textContent = cat || '全部';
 emptyState.classList.toggle('hidden', visible >0);
 hint.classList.toggle('hidden', !cat);
 if (cat) hint.textContent = filterHintTemplate.replace('{category}', cat);

 // Update active link
 document.querySelectorAll('.filter-link').forEach((link) => {
 link.classList.toggle('is-active',
 (cat && link.href.includes(`category=${encodeURIComponent(cat)}`)) ||
 (!cat && link.id === 'filter-all')
 );
 });
 }

 applyFilter(activeCategory);

 // Re-apply on popstate (back/forward browser nav)
 window.addEventListener('popstate', () => {
 const p = new URLSearchParams(window.location.search);
 applyFilter(p.get('category') || '');
 });
</script>

<style>
 .hidden { display: none; }

 /* ==================================================================
 Page header — shud.in 项目页风格: H1 与正文接近、weight500
 ================================================================== */
 .page-header {
 margin-bottom:32px;
 }

 .page-title {
 font-size:22px;
 font-weight:500;
 color: var(--text);
 letter-spacing: -0.02em;
 line-height:1.25;
 margin:0;
 text-wrap: balance;
 }

 .page-lead {
 margin-top:20px;
 color: var(--text-muted);
 font-size:15px;
 line-height:1.6;
 max-width:38em;
 text-wrap: pretty;
 }

 .filter-hint {
 display: inline;
 color: var(--text-subtle);
 font-style: italic;
 margin-left:0.25em;
 }

 /* ==================================================================
 Section heading — 与正文同字号差,weight500
 ================================================================== */
 .project-section {
 margin-bottom:48px;
 }

 .section-heading {
 font-size:18px;
 font-weight:500;
 color: var(--text);
 letter-spacing:0;
 line-height:1.3;
 margin:0016px0;
 text-wrap: balance;
 }

 .filter-heading {
 /* JS 直接改 textContent,样式继承 .section-heading */
 }

 /* ==================================================================
 Project list — article-row风格,无 border / 无 background
 ================================================================== */
 .project-list {
 list-style: none;
 padding:0;
 margin:0;
 }

 .project-item {
 padding:8px014px0;
 }

 /* ---- Row:标题 + dot-leader + meta ---- */
 .project-row {
 display: flex;
 align-items: baseline;
 gap:8px;
 text-decoration: none;
 color: var(--text);
 transition: color150ms ease;
 }

 .project-title {
 flex:01 auto;
 color: var(--text);
 font-size:15px;
 font-weight:500;
 text-decoration: underline;
 text-decoration-color: var(--border);
 text-decoration-thickness:1px;
 text-underline-offset:2px;
 transition: color150ms ease, text-decoration-color150ms ease;
 }

 .leader {
 flex:11 auto;
 min-width:1em;
 height:1em;
 background-image: radial-gradient(
 circle,
 var(--border)1px,
 transparent1.5px
 );
 background-size:6px6px;
 background-repeat: repeat-x;
 background-position:070%;
 transition: background-image150ms ease;
 }

 .project-meta {
 flex:00 auto;
 display: inline-flex;
 align-items: baseline;
 gap:10px;
 color: var(--text-subtle);
 font-size:13px;
 font-variant-numeric: tabular-nums;
 letter-spacing: -0.01em;
 transition: color150ms ease;
 }

 .project-status {
 color: var(--text-subtle);
 font-weight:400;
 font-size: inherit;
 }

 .project-cat {
 color: var(--text-subtle);
 font-style: italic;
 }

 /* hover:标题 + leader + meta 三色同步加深 */
 .project-row:hover .project-title {
 color: var(--text);
 text-decoration-color: var(--text);
 }
 .project-row:hover .leader {
 background-image: radial-gradient(
 circle,
 var(--text-muted)1px,
 transparent1.5px
 );
 }
 .project-row:hover .project-meta {
 color: var(--text-muted);
 }

 /* ---- Summary: muted 一行说明 ---- */
 .project-summary {
 margin:4px000;
 color: var(--text-muted);
 font-size:13px;
 line-height:1.55;
 max-width:38em;
 }

 /* ---- Empty state ---- */
 .empty-state {
 padding:24px0;
 font-size:13px;
 color: var(--text-muted);
 }

 /* ==================================================================
 Aside — filter / about
 ================================================================== */
 .aside-block {
 margin-bottom:32px;
 }

 .aside-title {
 font-size:13px;
 font-weight:500;
 color: var(--text);
 letter-spacing:0;
 text-transform: none; /* override global uppercase */
 margin:0012px0;
 }

 .aside-body {
 font-size:13px;
 line-height:1.65;
 color: var(--text-muted);
 }

 .filter-list {
 list-style: none;
 padding:0;
 margin:0;
 font-size:13px;
 }

 .filter-link {
 display: flex;
 justify-content: space-between;
 align-items: baseline;
 padding:3px0;
 color: var(--text-muted);
 text-decoration: none;
 transition: color150ms ease;
 }

 .filter-link:hover {
 color: var(--text);
 }

 .filter-link.is-active {
 color: var(--text);
 font-weight:500;
 }

 .filter-count {
 color: var(--text-subtle);
 font-variant-numeric: tabular-nums;
 font-size:12px;
 }

 /* ==================================================================
 Responsive —移动端
 ================================================================== */
 @media (max-width:767px) {
 .page-title { font-size:20px; }
 .section-heading { font-size:17px; }
 .project-title { font-size:15px; }
 .project-meta { gap:8px; }
 .project-summary { font-size:13px; }
 }
</style>
