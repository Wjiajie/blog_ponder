---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PAGE_META, ROUTES, STATUS_META } from '../consts';

// Always render all projects; filter is done client-side via JS
const all = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

// Derive categories from the collection (no hardcoded list)
const categories = Array.from(new Set(all.map((p) => p.data.category))).sort();

// Render a project status as `${symbol} ${label}`, falling back to the raw
// status string if a new enum value is added before STATUS_META is updated.
const formatProjectStatus = (s: string): string => {
  const meta = STATUS_META.project[s as keyof typeof STATUS_META.project];
  return meta ? `${meta.symbol} ${meta.label}` : s;
};
---

<BaseLayout
  title={PAGE_META.projects.title}
  description={PAGE_META.projects.description}
  showRightAside={true}
>
  <header class="page-header">
    <h1>Projects</h1>
    <p class="text-muted" style="font-size: var(--fs-sm); margin-top: var(--space-2);">
      Built to demonstrate the customer-facing engineering work of a Forward Deployed Engineer.
      <span id="filter-hint" class="hidden"></span>
    </p>
  </header>

  <section class="project-section">
    <h2 id="filter-heading" class="section-subtitle">All</h2>
    <ul class="project-list">
      {all.map((p) => (
        <li class="project-item" data-category={p.data.category}>
          <h3 class="project-title">{p.data.title}</h3>
          <p class="project-summary">{p.data.summary}</p>
          <p class="project-meta">
            <span class="project-status">{formatProjectStatus(p.data.status)}</span>
            {p.data.stack.length > 0 && (
              <span class="project-stack">
                {p.data.stack.map((s) => <code>{s}</code>)}
              </span>
            )}
          </p>
          <div class="project-links">
            {p.data.links.post && <a href={p.data.links.post}>read more</a>}
            {p.data.links.repo && <a href={p.data.links.repo}>github</a>}
            {p.data.links.demo && <a href={p.data.links.demo}>demo</a>}
          </div>
        </li>
      ))}
    </ul>
    <p id="empty-state" class="text-muted hidden">
      No projects in this category yet — <a href="/projects/">view all</a>.
    </p>
  </section>

  <Fragment slot="aside">
    <section class="aside-block">
      <h3 class="section-subtitle">Filter</h3>
      <ul class="filter-list">
        <li>
          <a id="filter-all" href={ROUTES.projects} class="filter-link is-active">
            All
            <span class="filter-count">{all.length}</span>
          </a>
        </li>
        {categories.map((c) => {
          const count = all.filter((p) => p.data.category === c).length;
          return (
            <li>
              <a
                id={`filter-${c}`}
                href={`/projects/?category=${encodeURIComponent(c)}`}
                class="filter-link"
              >
                {c}
                <span class="filter-count">{count}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  </Fragment>
</BaseLayout>

<script>
  // Client-side category filter — works on static build
  const params = new URLSearchParams(window.location.search);
  const activeCategory = params.get('category') || '';

  function applyFilter(cat: string) {
    const items = document.querySelectorAll<HTMLElement>('.project-item');
    const heading = document.getElementById('filter-heading')!;
    const hint = document.getElementById('filter-hint')!;
    const emptyState = document.getElementById('empty-state')!;

    let visible = 0;
    items.forEach((item) => {
      const match = !cat || item.dataset.category === cat;
      item.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    heading.textContent = cat || 'All';
    emptyState.classList.toggle('hidden', visible > 0);
    hint.classList.toggle('hidden', !cat);
    if (cat) hint.textContent = `· filtered by ${cat}`;

    // Update active link
    document.querySelectorAll('.filter-link').forEach((link) => {
      link.classList.toggle('is-active',
        (cat && (link as HTMLAnchorElement).href.includes(`category=${encodeURIComponent(cat)}`)) ||
        (!cat && (link as HTMLAnchorElement).id === 'filter-all')
      );
    });
  }

  applyFilter(activeCategory);

  // Re-apply on popstate (back/forward browser nav)
  window.addEventListener('popstate', () => {
    const p = new URLSearchParams(window.location.search);
    applyFilter(p.get('category') || '');
  });
</script>

<style>
  .hidden { display: none; }
  .page-header { margin-bottom: var(--space-12); }
  .project-section { margin-bottom: var(--space-12); }
  .project-list { list-style: none; padding: 0; margin: 0; }
  .project-item { padding: var(--space-6) 0; border-bottom: 1px solid var(--border); }
  .project-item:last-child { border-bottom: none; }
  .project-title { font-size: var(--fs-lg); font-weight: 600; margin: 0 0 var(--space-2) 0; }
  .project-summary { color: var(--text-muted); font-size: var(--fs-sm); margin-bottom: var(--space-3); }
  .project-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); font-size: var(--fs-xs); }
  .project-status { color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .project-stack { display: inline-flex; flex-wrap: wrap; gap: var(--space-2); }
  .project-stack code { font-size: var(--fs-xs); color: var(--text-muted); }
  .project-links { display: flex; gap: var(--space-4); font-size: var(--fs-sm); }
  .project-links a { color: var(--text-muted); }
  .project-links a:hover { color: var(--text); }
  .filter-list { list-style: none; padding: 0; margin: 0; font-size: var(--fs-sm); }
  .filter-link { display: flex; justify-content: space-between; padding: var(--space-1) 0; color: var(--text-muted); text-decoration: none; }
  .filter-link:hover { color: var(--text); }
  .filter-link.is-active { color: var(--text); font-weight: 500; }
  .filter-count { color: var(--text-subtle); font-variant-numeric: tabular-nums; }
</style>

