# Dependencies
/node_modules

# Astro build output
/dist
/.astro

# Docusaurus leftovers (kept on disk for main branch reference, not tracked here)
/docusaurus.config.ts
/sidebars.ts
/blog
/static
/api
/server
/plans
/drafts
/.docusaurus
/.cache-loader
/ralph.yml
/PROMPT.md
/titles.txt
/debug.log
/.env.local

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# Local tool caches (not source)
.cursor/
.claude/
.memsearch/
.obsidian/

# ralph tool diagnostic logs (regenerated each run)
/.ralph/diagnostics/
/.ralph/events-*.jsonl
/.ralph/agent/

# OG/favicon design workspace (sandbox for build scripts and previews)
/icon-design/

# Dev server logs (regenerated on every `astro dev`)
/dev-stderr.log
/dev-stdout.log
/dev.out.log
/dev.err.log

# Local diagram preview (sandbox for design review; regenerated on demand)
/diagrams/preview.html

# Rendered diagram PNGs — produced by `npm run diagrams` (and the predev/
# prebuild hooks) from the SVG sources in diagrams/. Never edit by hand.
/diagrams/*.png

# public/diagrams/ is fully generated by scripts/render-diagrams.cjs from
# the SVG sources in diagrams/. The post only ever references PNGs here;
# SVGs aren't served.
/public/diagrams/

# Stale OG-image drafts left over from old workflows (real OG is generated
# dynamically by src/pages/og/blog/[slug].png.ts)
/public/blog/*.png
